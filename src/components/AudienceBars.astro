---
import type { AudienceItem } from '../data/linkedin';

interface Props {
  title: string;
  items: AudienceItem[];
  limit?: number;
}
const { title, items, limit = 5 } = Astro.props;
const shown = items.slice(0, limit);
const max = Math.max(...shown.map((i) => i.pct));
const label = (p: number) => (p < 1 ? '<1 %' : `${p} %`);
// "Área metropolitana de Santiago" -> "Santiago"; "Buenos Aires y alrededores" -> "Buenos Aires"
const short = (s: string) => s.replace(/^Área metropolitana de /, '').replace(/ y alrededores.*$/, '');
---

<figure class="card">
  <figcaption class="kicker">{title}</figcaption>
  <ul>
    {
      shown.map((i) => (
        <li title={`${i.label}: ${label(i.pct)} de los seguidores`}>
          <span class="name">{short(i.label)}</span>
          <span class="val num">{label(i.pct)}</span>
          <span class="track">
            <span class="bar" style={`width:${(i.pct / max) * 100}%`} />
          </span>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  figure { margin: 0; padding: 20px; }
  figcaption { margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  li { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; font-size: 0.88rem; }
  .val { font-family: var(--head); font-weight: 600; white-space: nowrap; }
  .track { grid-column: 1 / -1; height: 6px; border-radius: 3px; background: var(--card-2); }
  .bar { display: block; height: 100%; border-radius: 3px; background: var(--gradient); }
</style>
