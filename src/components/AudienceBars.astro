---
import type { AudienceItem } from '../data/linkedin';

interface Props {
  title: string;
  items: AudienceItem[];
  limit?: number;
}
const { title, items, limit = 5 } = Astro.props;
const shown = items.slice(0, limit);
const max = Math.max(...shown.map((i) => i.pct));
const label = (p: number) => (p < 1 ? '<1 %' : `${p} %`);
// "Área metropolitana de Santiago" -> "Santiago"; "Buenos Aires y alrededores" -> "Buenos Aires"
const short = (s: string) => s.replace(/^Área metropolitana de /, '').replace(/ y alrededores.*$/, '');
---

<figure class="audience">
  <figcaption>{title}</figcaption>
  <ul>
    {
      shown.map((i) => (
        <li title={`${i.label}: ${label(i.pct)} de los seguidores`}>
          <div class="row">
            <span class="name">{short(i.label)}</span>
            <span class="val">{label(i.pct)}</span>
          </div>
          <div class="track">
            <span class="bar" style={`width:${(i.pct / max) * 100}%`} />
          </div>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .audience { margin: 0; padding: 24px; border-radius: var(--radius); background: var(--card); border: 1px solid var(--border); }
  figcaption { font-family: var(--mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 16px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .row { display: flex; justify-content: space-between; gap: 12px; font-size: 0.92rem; margin-bottom: 6px; }
  .val { font-family: var(--mono); font-weight: 600; white-space: nowrap; }
  .track { height: 8px; border-radius: 4px; background: var(--bg-soft); }
  .bar { display: block; height: 100%; border-radius: 4px; background: var(--brand-2); }
  li:hover .bar { filter: brightness(1.2); }
</style>
