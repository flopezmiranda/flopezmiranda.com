---
import type { AudienceItem } from '../data/linkedin';

interface Props {
  title: string;
  items: AudienceItem[];
  limit?: number;
}
const { title, items, limit = 5 } = Astro.props;
const shown = items.slice(0, limit);
const max = Math.max(...shown.map((i) => i.pct));
const label = (p: number) => (p < 1 ? '<1 %' : `${p} %`);
// "Área metropolitana de Santiago" -> "Santiago"; "Buenos Aires y alrededores" -> "Buenos Aires"
const short = (s: string) => s.replace(/^Área metropolitana de /, '').replace(/ y alrededores.*$/, '');
---

<figure>
  <figcaption class="label">{title}</figcaption>
  <ul>
    {
      shown.map((i) => (
        <li title={`${i.label}: ${label(i.pct)} de los seguidores`}>
          <span class="name">{short(i.label)}</span>
          <span class="val num">{label(i.pct)}</span>
          <span class="track">
            <span class="bar" style={`width:${(i.pct / max) * 100}%`} />
          </span>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  figure { margin: 0; }
  figcaption { display: block; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 0.92rem; }
  .val { font-weight: 500; white-space: nowrap; }
  .track { grid-column: 1 / -1; height: 2px; background: var(--line); }
  .bar { display: block; height: 100%; background: var(--gradient); }
  .track { height: 4px !important; border-radius: 2px; }
  .bar { border-radius: 2px; }
</style>
