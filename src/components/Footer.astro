---
import { SOCIAL, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="container">
  <p class="sign serif">Hablemos en <a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></p>
  <div class="bottom">
    <span>© {year} {SITE_TITLE}</span>
    <span class="links">
      {SOCIAL.x && <a href={SOCIAL.x} target="_blank" rel="noopener">X</a>}
      {SOCIAL.email && <a href={`mailto:${SOCIAL.email}`}>Email</a>}
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  footer { margin-top: 140px; padding-bottom: 40px; }
  .sign { font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; margin: 0 0 48px; }
  .sign a { color: var(--accent); text-decoration: none; }
  .sign a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 0.82rem; color: var(--muted); }
  .links { display: flex; gap: 18px; }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--text); }
</style>
