---
import { SOCIAL, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <p>© {year} {SITE_TITLE}</p>
    <ul>
      <li><a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href={SOCIAL.x} target="_blank" rel="noopener">X</a></li>
      <li><a href={SOCIAL.email}>Email</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); margin-top: 64px; padding: 28px 0; color: var(--muted); font-size: 0.9rem; }
  .inner { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; }
  p { margin: 0; }
  ul { display: flex; gap: 18px; list-style: none; margin: 0; padding: 0; }
  a { color: var(--muted); }
  a:hover { color: var(--text); }
</style>
