---
import LinkedInButtons from './LinkedInButtons.astro';
import { SOCIAL, SITE_TITLE, LINKEDIN_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer>
  <div class="container cols">
    <div class="brand">
      <p class="logo"><span class="mark">FLM</span> Felipe López Miranda</p>
      <p class="muted">Marketing, datos e inteligencia artificial.</p>
      <LinkedInButtons />
    </div>
    <ul>
      <li class="h">Redes</li>
      <li><a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a></li>
      {SOCIAL.instagram && <li><a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>}
      {SOCIAL.email && <li><a href={`mailto:${SOCIAL.email}`}>Email</a></li>}
    </ul>
    <ul>
      <li class="h">Proyectos</li>
      <li><a href="https://efectopodcast.com/" target="_blank" rel="noopener">Efecto Podcast</a></li>
      <li><a href="/droneimagen/">DroneImagen</a></li>
      <li><a href="https://www.droneimagen.cl/" target="_blank" rel="noopener">droneimagen.cl ↗</a></li>
    </ul>
    <ul>
      <li class="h">Sitio</li>
      <li><a href="/sobre-mi/">Sobre mí</a></li>
      <li><a href="/blog/">Escritos</a></li>
      <li><a href="/linkedin/">Publicaciones</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
  <p class="container copy">© {year} {SITE_TITLE}</p>
</footer>

<style>
  footer { border-top: 1px solid var(--line); margin-top: 48px; padding-top: 48px; font-size: 0.88rem; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  .logo { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-family: var(--head); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.8rem; }
  .mark { font-weight: 800; padding: 4px 7px; border-radius: 7px; background: var(--accent); color: var(--on-accent); letter-spacing: 0; }
  .brand p.muted { margin: 0 0 18px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .h { font-family: var(--head); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; }
  ul a { color: var(--muted); text-decoration: none; }
  ul a:hover { color: var(--text); }
  .copy { margin: 48px auto 0; padding-block: 20px; font-size: 0.75rem; color: var(--faint); }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
</style>
