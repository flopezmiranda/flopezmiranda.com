---
import { LINKEDIN_URL } from '../consts';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/blog/', label: 'Escritos' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
const active = (href: string) => (href === '/' ? path === '/' : href.startsWith('/#') ? false : path.startsWith(href));
---

<header>
  <div class="container bar">
    <a href="/" class="logo"><span class="mark">FLM</span><span class="name">Felipe López Miranda</span></a>
    <nav>
      {links.map((l) => <a href={l.href} class:list={{ on: active(l.href) }}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary cta" href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn ↗</a>
  </div>
</header>

<style>
  header { position: sticky; top: 0; z-index: 20; background: rgba(9, 6, 25, 0.8); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; height: 60px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--head); }
  .mark { font-weight: 800; font-size: 0.85rem; padding: 4px 7px; border-radius: 7px; background: var(--gradient); color: #fff; }
  .name { font-weight: 600; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; }
  nav { display: flex; gap: 4px; margin-left: auto; }
  nav a { padding: 6px 12px; border-radius: 999px; font-size: 0.82rem; font-family: var(--head); font-weight: 500; color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--text); }
  nav a.on { color: var(--text); background: var(--card-2); }
  .cta { padding: 7px 14px; font-size: 0.8rem; }
  @media (max-width: 820px) { nav { display: none; } .cta { margin-left: auto; } }
  @media (max-width: 420px) { .name { display: none; } }
</style>
