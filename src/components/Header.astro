---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/blog/', label: 'Blog' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
---

<header>
  <nav class="container">
    <a href="/" class="logo">FLM<span class="gradient-text">.</span></a>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} class={path === l.href || (l.href !== '/' && path.startsWith(l.href)) ? 'active' : ''}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: rgba(11, 13, 23, 0.75);
    border-bottom: 1px solid var(--border);
  }
  nav { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .logo { font-weight: 800; font-size: 1.3rem; color: var(--text); letter-spacing: -0.03em; }
  .logo:hover { text-decoration: none; }
  ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; }
  ul a { color: var(--muted); font-weight: 600; font-size: 0.95rem; }
  ul a:hover, ul a.active { color: var(--text); text-decoration: none; }
  ul a.active { border-bottom: 2px solid var(--brand-2); padding-bottom: 4px; }
</style>
