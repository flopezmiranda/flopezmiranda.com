---
import { LINKEDIN_URL, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const links = [
  { href: '/blog/', label: 'Escritos' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
---

<header class="container">
  <a href="/" class="name">{SITE_TITLE}</a>
  <nav>
    {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="ext">LinkedIn ↗</a>
  </nav>
</header>

<style>
  header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 28px; padding-bottom: 28px; }
  a { text-decoration: none; }
  .name { font-family: var(--serif); font-size: 1.45rem; letter-spacing: -0.01em; white-space: nowrap; }
  nav { display: flex; gap: 28px; font-size: 0.92rem; }
  nav a { color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  nav a.ext { color: var(--accent); }
  @media (max-width: 560px) {
    header { flex-direction: column; align-items: flex-start; gap: 6px; padding-top: 20px; padding-bottom: 12px; }
    nav { gap: 20px; }
  }
</style>
