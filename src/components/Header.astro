---
import { LINKEDIN_URL } from '../consts';

const path = Astro.url.pathname;
const links = [
  { href: '/blog/', label: 'Escritos' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
---

<header class="container">
  <a href="/" class="name">Felipe<strong>LópezMiranda</strong></a>
  <nav>
    {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="pill">Sígueme en LinkedIn</a>
  </nav>
</header>

<style>
  header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 22px; padding-bottom: 22px; }
  a { text-decoration: none; }
  .name { font-family: var(--serif); font-size: 1.35rem; white-space: nowrap; }
  .name strong { font-family: var(--sans); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.02em; margin-left: 2px; }
  nav { display: flex; align-items: center; gap: 26px; font-size: 0.9rem; }
  nav a:not(.pill) { color: var(--muted); }
  nav a:not(.pill):hover, nav a[aria-current='page'] { color: var(--text); }
  @media (max-width: 640px) {
    nav a:not(.pill) { display: none; }
    .pill { padding: 7px 14px; font-size: 0.8rem; }
  }
</style>
