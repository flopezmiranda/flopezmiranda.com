---
// Ilustración animada de la portada: "cómo aprende una campaña".
// Señales (con los colores de las capas de la Tabla periódica) → IA → resultados, y una curva de crecimiento.
// Hecha solo con SVG y CSS: sin imágenes, se adapta al modo oscuro y se queda quieta con "reducir movimiento".
const senales = [
  { t: 'Píxel', c: '#45bfff', y: 92 },
  { t: 'Conversions API', c: '#45bfff', y: 146 },
  { t: 'CRM', c: '#a98bff', y: 200 },
  { t: 'Creatividad', c: '#ff7f9e', y: 254 },
];
const resultados = [
  { t: 'ROAS', a: '↑', y: 119 },
  { t: 'CPA', a: '↓', y: 173 },
  { t: 'Ventas', a: '↑', y: 227 },
];
const N = { x: 262, y: 173 };
const inPath = (y: number) => `M168,${y} C202,${y} 202,${N.y} ${N.x - 48},${N.y}`;
const outPath = (y: number) => `M${N.x + 48},${N.y} C340,${N.y} 336,${y} 366,${y}`;
const curva = 'M24,420 C70,416 100,410 140,402 C180,394 205,392 240,380 C280,366 300,362 340,350 C380,338 400,326 440,314 C465,307 482,302 496,298';
---

<svg class="hg" viewBox="0 0 520 460" role="img" aria-labelledby="hg-t hg-d">
  <title id="hg-t">Cómo aprende una campaña</title>
  <desc id="hg-d">Ilustración animada: señales como el píxel, Conversions API, el CRM y la creatividad alimentan a la IA de la plataforma, que mejora el ROAS, baja el CPA y hace crecer las ventas.</desc>
  <defs>
    <linearGradient id="hg-area" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="hg-stop1" />
      <stop offset="1" class="hg-stop2" />
    </linearGradient>
  </defs>

  <rect class="hg-card" x="1" y="1" width="518" height="458" rx="22" />
  <text class="hg-kicker" x="26" y="40">CÓMO APRENDE UNA CAMPAÑA</text>
  <g class="hg-dots"><circle cx="458" cy="35" r="4" /><circle cx="474" cy="35" r="4" /><circle cx="490" cy="35" r="4" /></g>

  <!-- Flujos -->
  {senales.map((s, i) => (
    <g>
      <path class="hg-flow" d={inPath(s.y)} />
      <circle class="hg-pulse" r="4" style={`fill:${s.c}`}>
        <animateMotion dur="2.4s" begin={`${i * 0.45}s`} repeatCount="indefinite" path={inPath(s.y)} />
      </circle>
    </g>
  ))}
  {resultados.map((r, i) => (
    <g>
      <path class="hg-flow" d={outPath(r.y)} />
      <circle class="hg-pulse hg-pulse-out" r="4">
        <animateMotion dur="2s" begin={`${1.2 + i * 0.4}s`} repeatCount="indefinite" path={outPath(r.y)} />
      </circle>
    </g>
  ))}

  <!-- Señales -->
  {senales.map((s, i) => (
    <g class="hg-pill hg-in" style={`animation-delay:${i * 0.15}s`}>
      <rect x="24" y={s.y - 18} width="144" height="36" rx="18" />
      <circle cx="44" cy={s.y} r="6" style={`fill:${s.c}`} />
      <text x="58" y={s.y + 4.5}>{s.t}</text>
    </g>
  ))}

  <!-- Nodo de IA -->
  <circle class="hg-ring" cx={N.x} cy={N.y} r="48" />
  <circle class="hg-ring hg-ring2" cx={N.x} cy={N.y} r="48" />
  <circle class="hg-node" cx={N.x} cy={N.y} r="48" />
  <text class="hg-node-t" x={N.x} y={N.y + 9} text-anchor="middle">IA</text>

  <!-- Resultados -->
  {resultados.map((r, i) => (
    <g class="hg-pill hg-out" style={`animation-delay:${1.6 + i * 0.35}s`}>
      <rect x="366" y={r.y - 18} width="130" height="36" rx="18" />
      <text x="388" y={r.y + 4.5}>{r.t}</text>
      <text class="hg-arrow" x="474" y={r.y + 5} text-anchor="middle">{r.a}</text>
    </g>
  ))}

  <!-- Curva de crecimiento -->
  <text class="hg-kicker" x="26" y="318">RESULTADO</text>
  <g class="hg-grid"><line x1="24" y1="345" x2="496" y2="345" /><line x1="24" y1="382" x2="496" y2="382" /><line x1="24" y1="420" x2="496" y2="420" /></g>
  <path class="hg-area" d={`${curva} L496,420 L24,420 Z`} />
  <path class="hg-line" d={curva} pathLength="1" />
  <circle class="hg-end" cx="496" cy="298" r="6" />
</svg>

<style>
  .hg { display: block; width: 100%; height: auto; font-family: var(--head); overflow: visible; filter: drop-shadow(0 30px 40px rgba(11, 27, 58, 0.18)); }
  .hg-card { fill: var(--bg); stroke: var(--line); }
  .hg-kicker { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; fill: var(--accent); }
  .hg-dots circle { fill: var(--line); }

  .hg-flow { fill: none; stroke: var(--muted); stroke-width: 1.6; stroke-dasharray: 3 7; stroke-linecap: round; opacity: 0.55; animation: hg-flow 1s linear infinite; }
  .hg-pulse-out { fill: var(--accent); }

  .hg-pill rect { fill: var(--card); stroke: var(--line); }
  .hg-pill text { font-size: 13px; font-weight: 600; fill: var(--text); }
  .hg-arrow { font-size: 17px !important; font-weight: 800 !important; fill: #12a56b !important; }
  .hg-in, .hg-out { transform-box: fill-box; transform-origin: center; }
  .hg-in { animation: hg-in 0.6s ease-out both; }
  .hg-out { animation: hg-pop 6s ease-in-out infinite both; }

  .hg-node { fill: var(--accent); }
  .hg-node-t { font-size: 26px; font-weight: 800; fill: var(--on-accent); }
  .hg-ring { fill: none; stroke: var(--accent); stroke-width: 2; transform-box: fill-box; transform-origin: center; animation: hg-ring 2.4s ease-out infinite; }
  .hg-ring2 { animation-delay: 1.2s; }

  .hg-grid line { stroke: var(--line); stroke-dasharray: 2 6; }
  .hg-stop1 { stop-color: var(--accent); stop-opacity: 0.28; }
  .hg-stop2 { stop-color: var(--accent); stop-opacity: 0; }
  .hg-area { fill: url(#hg-area); animation: hg-area 6s ease-in-out infinite; }
  .hg-line { fill: none; stroke: var(--accent); stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: 1; animation: hg-draw 6s ease-in-out infinite; }
  .hg-end { fill: var(--accent); stroke: var(--bg); stroke-width: 3; transform-box: fill-box; transform-origin: center; animation: hg-end 6s ease-in-out infinite; }

  @keyframes hg-flow { to { stroke-dashoffset: -20; } }
  @keyframes hg-in { from { opacity: 0; transform: translateX(-12px); } }
  @keyframes hg-pop { 0%, 8% { opacity: 0; transform: scale(0.85); } 16%, 88% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.95); } }
  @keyframes hg-ring { from { opacity: 0.6; transform: scale(1); } to { opacity: 0; transform: scale(1.7); } }
  @keyframes hg-draw { 0% { stroke-dashoffset: 1; opacity: 1; } 50%, 88% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes hg-area { 0%, 30% { opacity: 0; } 55%, 88% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes hg-end { 0%, 45% { opacity: 0; transform: scale(0.4); } 52%, 88% { opacity: 1; transform: scale(1); } 100% { opacity: 0; } }

  /* Reducir movimiento: todo queda dibujado y quieto */
  @media (prefers-reduced-motion: reduce) {
    .hg *, .hg { animation: none !important; }
    .hg-pulse, .hg-ring { display: none; }
    .hg-line { stroke-dashoffset: 0; }
  }
</style>
