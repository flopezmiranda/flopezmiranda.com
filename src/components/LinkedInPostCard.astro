---
import type { LinkedInPost } from '../data/linkedin-posts';
import FormattedDate from './FormattedDate.astro';
import LinkedInIcon from './LinkedInIcon.astro';

interface Props {
  post: LinkedInPost;
}
const { post } = Astro.props;
const nf = new Intl.NumberFormat('es-CL');
---

<a class="card" href={post.url} target="_blank" rel="noopener">
  <div class="meta">
    <span class="chip" data-cat={post.category}>{post.category}</span>
    <FormattedDate date={new Date(post.date)} />
  </div>
  <p class="text">{post.text}</p>
  <div class="foot">
    <span class="numbers">
      {post.impressions != null && <span>👁 {nf.format(post.impressions)}</span>}
      {post.reactions != null && <span>👍 {nf.format(post.reactions)}</span>}
    </span>
    <span class="more"><LinkedInIcon size={14} /> Ver en LinkedIn →</span>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 12px; padding: 24px; border-radius: var(--radius); background: var(--card); border: 1px solid var(--border); color: var(--text); transition: border-color 0.2s, transform 0.2s; }
  .card:hover { text-decoration: none; border-color: var(--linkedin); transform: translateY(-3px); }
  .meta { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .text { margin: 0; flex: 1; white-space: pre-line; display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 0.85rem; }
  .numbers { display: flex; gap: 12px; font-family: var(--mono); color: var(--muted); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--linkedin-light); }
</style>
