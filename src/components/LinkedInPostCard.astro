---
import { formatNumber, type LinkedInPost } from '../data/linkedin';
import FormattedDate from './FormattedDate.astro';
import LinkedInIcon from './LinkedInIcon.astro';

interface Props {
  post: LinkedInPost;
  rank: number;
}
const { post, rank } = Astro.props;
---

<a class="card" href={post.url} target="_blank" rel="noopener">
  <div class="meta">
    <span class="rank">#{rank}</span>
    <FormattedDate date={new Date(post.date)} />
  </div>
  <p class="text">“{post.title}…”</p>
  <dl class="numbers">
    {
      post.impressions != null && (
        <div>
          <dt>impresiones</dt>
          <dd>{formatNumber(post.impressions)}</dd>
        </div>
      )
    }
    {
      post.interactions != null && (
        <div>
          <dt>interacciones</dt>
          <dd>{formatNumber(post.interactions)}</dd>
        </div>
      )
    }
  </dl>
  <span class="more"><LinkedInIcon size={14} /> Ver en LinkedIn →</span>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 14px; padding: 24px; border-radius: var(--radius); background: var(--card); border: 1px solid var(--border); color: var(--text); transition: border-color 0.2s, transform 0.2s; }
  .card:hover { text-decoration: none; border-color: var(--linkedin); transform: translateY(-3px); }
  .meta { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .rank { color: var(--accent); font-weight: 600; }
  .text { margin: 0; flex: 1; font-size: 1.1rem; font-weight: 600; line-height: 1.4; }
  .numbers { display: flex; gap: 24px; margin: 0; padding-top: 12px; border-top: 1px solid var(--border); }
  dt { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  dd { margin: 2px 0 0; font-family: var(--mono); font-size: 1.25rem; font-weight: 600; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.9rem; color: var(--linkedin-light); }
</style>
