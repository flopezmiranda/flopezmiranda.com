---
import { formatNumber, type LinkedInPost } from '../data/linkedin';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: LinkedInPost;
  rank: number;
}
const { post, rank } = Astro.props;
---

<a class="row" href={post.url} target="_blank" rel="noopener">
  <span class="rank num">{String(rank).padStart(2, '0')}</span>
  <span class="main">
    <span class="title serif">{post.title}…</span>
    <span class="date"><FormattedDate date={new Date(post.date)} /> · Ver en LinkedIn ↗</span>
  </span>
  <span class="metric">
    {post.impressions != null && <span class="value num">{formatNumber(post.impressions)}</span>}
    <span class="unit">impresiones</span>
  </span>
</a>

<style>
  .row { display: grid; grid-template-columns: 48px 1fr auto; gap: 24px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .rank { font-size: 0.82rem; color: var(--faint); }
  .main { display: flex; flex-direction: column; gap: 4px; }
  .title { font-size: 1.6rem; line-height: 1.2; transition: color 0.2s; }
  .date { font-size: 0.82rem; color: var(--muted); }
  .metric { text-align: right; display: flex; flex-direction: column; }
  .value { font-size: 1.1rem; font-weight: 500; }
  .unit { font-size: 0.75rem; color: var(--muted); }
  .row:hover .title { color: var(--accent); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 32px 1fr; gap: 4px 12px; }
    .metric { grid-column: 2; flex-direction: row; gap: 6px; align-items: baseline; text-align: left; }
    .title { font-size: 1.35rem; }
  }
</style>
