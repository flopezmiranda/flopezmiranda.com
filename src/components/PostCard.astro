---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}
const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---

<a class="card post" href={`/blog/${post.id}/`}>
  <figure class="cover">
    <img src={`/img/covers/${post.id}.webp`} alt="" width="1600" height="900" loading="lazy" decoding="async" />
    {post.data.series && <span class="badge">Newsletter</span>}
  </figure>
  <div class="body">
    <p class="kicker">{category}</p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <p class="meta"><FormattedDate date={pubDate} /></p>
  </div>
</a>

<style>
  .post { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
  .cover { position: relative; margin: 0; aspect-ratio: 16 / 9; overflow: hidden; }
  .cover img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .post:hover .cover img { transform: scale(1.03); }
  .badge { position: absolute; top: 10px; right: 10px; padding: 3px 9px; border-radius: 999px; background: #ffd60a; color: #0b1b3a; font-family: var(--head); font-weight: 700; font-size: 0.68rem; }
  .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .kicker { font-size: 0.64rem; }
  h3 { font-size: 1rem; line-height: 1.3; }
  .desc { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .meta { margin: auto 0 0; padding-top: 6px; font-size: 0.75rem; color: var(--faint); }
</style>
