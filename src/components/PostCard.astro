---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Thumb from './Thumb.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { title, description, pubDate, category } = post.data;
---

<a class="card post" href={`/blog/${post.id}/`}>
  <Thumb text={title} badge={category} variant={index + 2} />
  <div class="body">
    <p class="kicker">{category}</p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <p class="meta"><FormattedDate date={pubDate} /></p>
  </div>
</a>

<style>
  .post { display: flex; flex-direction: column; height: 100%; }
  .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .kicker { font-size: 0.64rem; }
  h3 { font-size: 1rem; line-height: 1.3; }
  .desc { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .meta { margin: auto 0 0; padding-top: 6px; font-size: 0.75rem; color: var(--faint); }
</style>
