---
import LinkedInButtons from '../components/LinkedInButtons.astro';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { LINKEDIN_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { minutes: number };
const { title, description, pubDate, updatedDate, category, tags, minutes } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container narrow">
    <header>
      <p class="kicker">{category} · <FormattedDate date={pubDate} /> · {minutes} min de lectura</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      {updatedDate && <p class="muted">Actualizado el <FormattedDate date={updatedDate} /></p>}
    </header>
    <div class="prose"><slot /></div>
    <footer class="card">
      {tags.length > 0 && <p class="tags">{tags.map((t) => <span>#{t}</span>)}</p>}
      <p>¿Te sirvió? Sigamos la conversación en LinkedIn.</p>
      <div class="actions">
        <LinkedInButtons />
        <a class="btn" href="/blog/">← Todos los escritos</a>
      </div>
    </footer>
  </article>
</Base>

<style>
  header { padding: 56px 0 32px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 14px 0 16px; }
  .lead { font-size: 1.15rem; color: var(--muted); margin: 0; }
  footer { margin-top: 56px; padding: 24px; }
  footer p { margin: 0 0 14px; }
  .tags { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.82rem; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
