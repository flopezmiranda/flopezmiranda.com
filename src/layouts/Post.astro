---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { LINKEDIN_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { minutes: number };
const { title, description, pubDate, updatedDate, category, tags, minutes } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container narrow">
    <header>
      <p class="label">{category} · <FormattedDate date={pubDate} /> · {minutes} min</p>
      <h1 class="serif">{title}</h1>
      <p class="lead">{description}</p>
      {updatedDate && <p class="note">Actualizado el <FormattedDate date={updatedDate} /></p>}
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer>
      {tags.length > 0 && <p class="tags">{tags.map((t) => <span>#{t}</span>)}</p>}
      <p>
        ¿Te sirvió? Sigue la conversación en <a class="arrow-link" href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn ↗</a>
      </p>
      <p><a href="/blog/">← Todos los escritos</a></p>
    </footer>
  </article>
</Base>

<style>
  header { padding: 64px 0 40px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
  h1 { font-size: clamp(2.6rem, 7vw, 4.2rem); line-height: 1; margin: 18px 0 20px; }
  .lead { font-size: 1.25rem; color: var(--muted); margin: 0; }
  footer { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 14px; font-size: 0.85rem; }
</style>
