---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & { minutes: number };
const { title, description, pubDate, updatedDate, category, tags, minutes } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container">
    <header class="post-head">
      <span class="chip" data-cat={category}>{category}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="stats">
        <span><FormattedDate date={pubDate} /></span>
        <span>{minutes} min de lectura</span>
        {updatedDate && <span>Actualizado <FormattedDate date={updatedDate} /></span>}
      </div>
    </header>
    <div class="prose">
      <slot />
      {tags.length > 0 && (
        <p class="tags">{tags.map((t) => <span class="chip">#{t}</span>)}</p>
      )}
      <p><a href="/blog/">← Volver al blog</a></p>
    </div>
  </article>
</Base>

<style>
  .post-head { max-width: 720px; margin: 0 auto; padding: 56px 0 24px; border-bottom: 1px solid var(--border); margin-bottom: 32px; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 16px 0 12px; }
  .lead { color: var(--muted); font-size: 1.15rem; margin: 0 0 20px; }
  .stats { display: flex; flex-wrap: wrap; gap: 18px; font-family: var(--mono); font-size: 0.8rem; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 40px; }
</style>
