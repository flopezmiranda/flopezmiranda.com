---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esta página no existe.">
  <section class="section container">
    <p class="kicker">Error 404</p>
    <h1 class="grad">Esta página no existe</h1>
    <a class="btn btn-primary" href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 12px 0 24px; text-transform: uppercase; display: inline-block; }
</style>
