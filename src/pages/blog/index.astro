---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils';

const posts = await getPosts();
const categories = ['Todos', 'Marketing', 'Datos', 'IA'];
---

<Base title="Escritos" description="Artículos sobre marketing, datos e inteligencia artificial.">
  <div class="container">
    <h1 class="display">Escritos</h1>
    <p class="intro">Ideas más largas sobre marketing, datos e inteligencia artificial.</p>
    <div class="filters" role="group" aria-label="Filtrar por tema">
      {categories.map((c) => <button type="button" data-filter={c}>{c}</button>)}
    </div>
    <div class="list">
      {
        posts.map((post) => (
          <div data-cat={post.data.category}>
            <PostCard post={post} />
          </div>
        ))
      }
    </div>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.list > [data-cat]');
  function apply(cat: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    items.forEach((el) => (el.hidden = cat !== 'Todos' && el.dataset.cat !== cat));
  }
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  const initial = new URLSearchParams(location.search).get('cat');
  apply(initial && [...buttons].some((b) => b.dataset.filter === initial) ? initial : 'Todos');
</script>

<style>
  .display { margin-top: 48px; }
  .intro { color: var(--muted); font-size: 1.15rem; margin: 20px 0 48px; }
  .filters { display: flex; flex-wrap: wrap; gap: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--text); }
  button { font: inherit; font-size: 0.9rem; padding: 0; border: 0; background: none; color: var(--muted); cursor: pointer; }
  button:hover { color: var(--text); }
  button[aria-pressed='true'] { color: var(--text); text-decoration: underline; text-underline-offset: 6px; }
</style>
