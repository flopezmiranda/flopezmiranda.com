---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils';
import LinkedInButtons from '../../components/LinkedInButtons.astro';
import { TOPICS } from '../../consts';

const posts = await getPosts();
// Filtros: todos, los cuatro temas y dos series (guías exclusivas y newsletter)
const count = (f: string) =>
  f === 'Todos' ? posts.length : f === 'Guías' ? posts.filter((p) => p.data.exclusive).length : f === 'Newsletter' ? posts.filter((p) => p.data.series).length : posts.filter((p) => p.data.category === f).length;
const categories = [
  { key: 'Todos', label: 'Todos' },
  ...TOPICS.map((t) => ({ key: t.cat, label: t.name, text: t.text })),
  { key: 'Guías', label: 'Guías exclusivas' },
  { key: 'Newsletter', label: 'Newsletter' },
];
---

<Base
  title="Escritos"
  description="Artículos de Felipe López Miranda sobre performance marketing, datos, inteligencia artificial y branding, ordenados por tema, más las ediciones de su newsletter."
  noindex={posts.length === 0}
  crumbs={[{ name: 'Escritos', path: '/blog/' }]}
>
  <section class="section container">
    <p class="kicker">Blog</p>
    <h1>Escritos</h1>
    <p class="muted intro">
      {posts.length} artículos ordenados por tema: performance, datos, IA y branding. ¿Buscas algo más corto? Revisa mis{' '}
      <a href="/linkedin/">publicaciones de LinkedIn</a>, con análisis nuevos cada semana.
    </p>
    {
      posts.length === 0 && (
        <div class="card empty">
          <p>Pronto publicaré aquí mis primeros artículos. Mientras tanto, todo mi contenido está en LinkedIn.</p>
          <LinkedInButtons />
        </div>
      )
    }
    <div class="filters" role="group" aria-label="Filtrar por tema" hidden={posts.length === 0}>
      {categories.map((c) => <button type="button" data-filter={c.key} data-text={c.text}>{c.label} <span>{count(c.key)}</span></button>)}
    </div>
    <p class="topic-text muted" id="topic-text" aria-live="polite"></p>
    <h2 class="vh">Artículos</h2>
    <div class="grid">
      {
        posts.map((post, i) => (
          <div data-cat={post.data.category} data-series={post.data.exclusive ? 'Guías' : post.data.series ? 'Newsletter' : ''}>
            <PostCard post={post} index={i} />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.grid > [data-cat]');
  const text = document.getElementById('topic-text')!;
  function apply(cat: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    const active = [...buttons].find((b) => b.dataset.filter === cat);
    text.textContent = active?.dataset.text ?? '';
    if (cat !== 'Todos') history.replaceState(null, '', `?cat=${encodeURIComponent(cat)}`);
    else history.replaceState(null, '', location.pathname);
    items.forEach((el) => (el.hidden = cat !== 'Todos' && el.dataset.cat !== cat && el.dataset.series !== cat));
  }
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  const initial = new URLSearchParams(location.search).get('cat');
  apply(initial && [...buttons].some((b) => b.dataset.filter === initial) ? initial : 'Todos');
</script>

<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 10px 0 8px; text-transform: uppercase; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .intro { margin: 0 0 28px; max-width: 680px; }
  .intro a { color: var(--accent); }
  .topic-text { margin: -12px 0 20px; min-height: 1.4em; font-size: 0.92rem; }
  button span { margin-left: 4px; font-weight: 400; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  button { font: inherit; font-family: var(--head); font-size: 0.82rem; font-weight: 500; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; }
  button:hover { color: var(--text); }
  button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); border-color: transparent; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .grid > div[hidden] { display: none; }
  .empty { padding: 24px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .empty p { margin: 0; color: var(--muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
