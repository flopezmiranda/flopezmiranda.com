---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils';
import LinkedInButtons from '../../components/LinkedInButtons.astro';

const posts = await getPosts();
const categories = ['Todos', 'Newsletter', 'Marketing', 'Datos', 'IA'];
---

<Base
  title="Escritos"
  description="Artículos de Felipe López Miranda sobre marketing, performance, datos e inteligencia artificial, y las ediciones de su newsletter Efecto Newsletter."
  noindex={posts.length === 0}
  crumbs={[{ name: 'Escritos', path: '/blog/' }]}
>
  <section class="section container">
    <p class="kicker">Blog</p>
    <h1>Escritos</h1>
    <p class="muted intro">{posts.length} artículos sobre marketing, performance, datos e inteligencia artificial, incluidas las ediciones de mi newsletter en LinkedIn.</p>
    {
      posts.length === 0 && (
        <div class="card empty">
          <p>Pronto publicaré aquí mis primeros artículos. Mientras tanto, todo mi contenido está en LinkedIn.</p>
          <LinkedInButtons />
        </div>
      )
    }
    <div class="filters" role="group" aria-label="Filtrar por tema" hidden={posts.length === 0}>
      {categories.map((c) => <button type="button" data-filter={c}>{c}</button>)}
    </div>
    <div class="grid">
      {
        posts.map((post, i) => (
          <div data-cat={post.data.category} data-series={post.data.series ? 'Newsletter' : ''}>
            <PostCard post={post} index={i} />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.grid > [data-cat]');
  function apply(cat: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    items.forEach((el) => (el.hidden = cat !== 'Todos' && el.dataset.cat !== cat && el.dataset.series !== cat));
  }
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  const initial = new URLSearchParams(location.search).get('cat');
  apply(initial && [...buttons].some((b) => b.dataset.filter === initial) ? initial : 'Todos');
</script>

<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 10px 0 8px; text-transform: uppercase; }
  .intro { margin: 0 0 28px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  button { font: inherit; font-family: var(--head); font-size: 0.82rem; font-weight: 500; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; }
  button:hover { color: var(--text); }
  button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); border-color: transparent; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .grid > div[hidden] { display: none; }
  .empty { padding: 24px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .empty p { margin: 0; color: var(--muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
