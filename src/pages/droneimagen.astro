---
import Base from '../layouts/Base.astro';
import { faqPage, droneimagen } from '../seo';
import { DI, MAIN_LINKS, MORE_LINKS, PLACES, REGIONS, COLLECTIONS, PHOTOS } from '../data/droneimagen';

const url = (path: string) => `${DI}${path}`;
const groups = [
  { title: 'Lugares', items: PLACES },
  { title: 'Regiones', items: REGIONS },
  { title: 'Colecciones', items: COLLECTIONS },
].filter((g) => g.items.length > 0);


const faqs = [
  { q: '¿Las fotos de DroneImagen son gratis?', a: 'Sí. Todas se descargan gratis, en alta resolución y sin marca de agua, creando una cuenta gratuita.' },
  { q: '¿Puedo usarlas en proyectos comerciales?', a: 'Sí, en proyectos personales y comerciales. Lo único que no se permite es revender o redistribuir los archivos como tales.' },
  { q: '¿Quién toma las fotos?', a: 'Todas las fotografías son de Felipe López Miranda, tomadas con drone en distintos lugares de Chile.' },
  { q: '¿Cómo encuentro una foto específica?', a: 'La galería tiene búsqueda inteligente con IA: puedes escribir lo que buscas con tus palabras, como "playa al atardecer" o "cerros de Valparaíso".' },
];

---

<Base
  title="DroneImagen"
  fullTitle="DroneImagen: 1.100 fotos aéreas gratis de Chile"
  description="Banco de fotos gratis con más de 1.100 fotografías aéreas de Chile tomadas con drone por Felipe López Miranda. Alta resolución, sin marca de agua."
  image="/og/droneimagen.jpg"
  imageAlt="Fotografía aérea de una costanera junto al mar, de DroneImagen"
  schema={[droneimagen, faqPage(faqs)]}
  crumbs={[{ name: 'DroneImagen', path: '/droneimagen/' }]}
>

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Proyecto personal · Banco de fotos</p>
        <h1>Drone<span class="grad">Imagen</span></h1>
        <p class="tag">Chile desde el aire, gratis.</p>
        <p class="intro">
          <a href={`${DI}/`} target="_blank" rel="noopener">DroneImagen</a> es un{' '}
          <a href={url('/banco-de-imagenes-gratis')} target="_blank" rel="noopener">banco de imágenes gratis de Chile</a> con más de
          1.100 fotografías aéreas que tomé con drone. Se descargan en alta resolución y sin marca de agua, para proyectos
          personales y comerciales.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={`${DI}/`} target="_blank" rel="noopener">Ir a droneimagen.cl ↗</a>
          <a class="btn" href={url('/galeria')} target="_blank" rel="noopener">Ver la galería ↗</a>
        </div>
      </div>
      <dl class="stats">
        <div><dd>+1.100</dd><dt>fotos aéreas</dt></div>
        <div><dd>31</dd><dt>lugares</dt></div>
        <div><dd>6</dd><dt>regiones</dt></div>
        <div><dd>8</dd><dt>colecciones</dt></div>
        <div><dd>11</dd><dt>guías</dt></div>
        <div><dd>0 $</dd><dt>para descargar</dt></div>
      </dl>
    </div>
  </section>

  <!-- Galería -->
  <section class="section container">
    <div class="section-head">
      <h2>Algunas fotos</h2>
      <a href={url('/galeria')} target="_blank" rel="noopener">Ver la galería completa →</a>
    </div>
    <div class="gallery">
      {
        PHOTOS.map((p) => (
          <a class:list={['shot', p.size]} href={url('/galeria')} target="_blank" rel="noopener">
            <img src={p.src} alt={`Fotografía aérea: ${p.alt.charAt(0).toLowerCase()}${p.alt.slice(1)}`} loading="lazy" />
            {p.place && <span class="place">{p.place}</span>}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="section container">
    <div class="section-head"><h2>Cómo funciona</h2></div>
    <ol class="steps">
      <li class="card"><b>1</b><h3>Busca</h3><p class="muted">Explora la <a href={url('/galeria')} target="_blank" rel="noopener">galería</a> o escribe lo que necesitas: la búsqueda entiende lenguaje natural.</p></li>
      <li class="card"><b>2</b><h3>Crea tu cuenta</h3><p class="muted">Es gratis y te permite descargar sin marca de agua.</p></li>
      <li class="card"><b>3</b><h3>Descarga</h3><p class="muted">Bájala en alta resolución y úsala en tu proyecto personal o comercial.</p></li>
      <li class="card"><b>4</b><h3>Revisa la licencia</h3><p class="muted">No se permite revender ni redistribuir los archivos. Detalles en la <a href={url('/licencia')} target="_blank" rel="noopener">licencia de uso</a>.</p></li>
    </ol>
  </section>

  <!-- Explora el sitio -->
  <section class="section container">
    <div class="section-head"><h2>Explora DroneImagen</h2></div>
    <div class="links">
      {
        MAIN_LINKS.map((l) => (
          <a class="card link" href={url(l.path)} target="_blank" rel="noopener">
            <span class="kicker">droneimagen.cl{l.path}</span>
            <h3>{l.label} ↗</h3>
            {l.text && <p class="muted">{l.text}</p>}
          </a>
        ))
      }
    </div>
    {
      groups.map((g) => (
        <div class="group">
          <h3>{g.title}</h3>
          <ul class="chips">
            {g.items.map((l) => (
              <li>
                <a href={url(l.path)} target="_blank" rel="noopener">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <ul class="more">
      {
        MORE_LINKS.map((l) => (
          <li>
            <a href={url(l.path)} target="_blank" rel="noopener">{l.label} ↗</a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section container faq-wrap">
    <div class="section-head"><h2>Preguntas frecuentes</h2></div>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
    <p class="back"><a class="btn" href="/">← Volver al inicio</a></p>
  </section>
</Base>

<style>
  .hero { padding: 64px 0 40px; background: radial-gradient(ellipse 60% 70% at 10% 0%, rgba(var(--accent-rgb), 0.12), transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  h1 { font-size: clamp(2.8rem, 7vw, 5rem); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1; margin: 14px 0 10px; }
  .tag { font-family: var(--head); font-weight: 600; font-size: 1.2rem; margin: 0; }
  .intro { color: var(--muted); max-width: 560px; margin: 18px 0 0; }
  .intro a, .steps a { color: var(--accent); font-weight: 500; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 0; }
  .stats div { padding: 18px; border-radius: var(--radius); background: var(--card); border: 1px solid var(--line); }
  .stats dd { margin: 0; font-family: var(--head); font-weight: 800; font-size: 1.8rem; line-height: 1; color: var(--accent); }
  .stats dt { font-size: 0.8rem; color: var(--muted); margin-top: 6px; }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 200px; gap: 12px; }
  .shot { position: relative; border-radius: var(--radius); overflow: hidden; display: block; }
  .shot.wide { grid-column: span 2; grid-row: span 2; }
  .shot.tall { grid-row: span 2; }
  .shot.long { grid-column: span 2; }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
  .shot:hover img { transform: scale(1.04); }
  .place { position: absolute; left: 12px; bottom: 12px; padding: 4px 10px; border-radius: 999px; background: rgba(0, 0, 0, 0.6); color: #fff; font-size: 0.78rem; font-family: var(--head); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .steps li { padding: 20px; }
  .steps b { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-family: var(--head); }
  .steps h3 { font-size: 1.05rem; margin: 12px 0 6px; }
  .steps p { margin: 0; font-size: 0.9rem; }

  .links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .link { padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .link .kicker { font-size: 0.62rem; text-transform: none; letter-spacing: 0.04em; }
  .link h3 { font-size: 1.1rem; }
  .link p { margin: 0; font-size: 0.88rem; }
  .group { margin-top: 28px; }
  .group h3 { font-size: 1rem; margin-bottom: 10px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-block; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; font-size: 0.85rem; }
  .chips a:hover { border-color: var(--accent); color: var(--accent); }
  .more { list-style: none; margin: 28px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 0.9rem; }
  .more a { color: var(--muted); }
  .more a:hover { color: var(--accent); }

  .faq-wrap { max-width: 820px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq summary { cursor: pointer; font-family: var(--head); font-weight: 600; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::after { content: '+'; color: var(--accent); font-size: 1.2rem; line-height: 1; }
  .faq details[open] summary::after { content: '–'; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq p { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; }
  .back { margin-top: 32px; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .steps, .links { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .gallery { grid-template-columns: 1fr 1fr; grid-auto-rows: 140px; }
    .shot.tall { grid-row: auto; }
    .steps, .links { grid-template-columns: 1fr; }
  }
</style>
