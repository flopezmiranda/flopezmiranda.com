---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import AudienceBars from '../components/AudienceBars.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKEDIN_URL } from '../consts';
import { LINKEDIN, compact, formatNumber } from '../data/linkedin';
import { getPosts } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const featured = LINKEDIN.topPosts.slice(0, 6);

// Últimos 12 meses (el primer mes del export suele traer solo 1 o 2 días)
const months = LINKEDIN.monthly.slice(-12);
const maxMonth = Math.max(...months.map((m) => m.impressions));
const peak = months.find((m) => m.impressions === maxMonth)!;
const monthName = (key: string, style: 'short' | 'narrow' = 'short') =>
  new Date(`${key}-15`).toLocaleDateString('es-ES', { month: style, year: style === 'short' ? 'numeric' : undefined });
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const engagement = ((LINKEDIN.interactions / LINKEDIN.impressions) * 100).toLocaleString('es-CL', { maximumFractionDigits: 1 });

const stats = [
  { value: formatNumber(LINKEDIN.followers), label: 'seguidores en LinkedIn', sub: `+${formatNumber(LINKEDIN.newFollowers)} en 12 meses` },
  { value: compact(LINKEDIN.impressions), label: 'impresiones', sub: 'últimos 12 meses' },
  { value: compact(LINKEDIN.reached), label: 'profesionales alcanzados', sub: 'personas únicas' },
  { value: compact(LINKEDIN.interactions), label: 'interacciones', sub: `${engagement} % de tasa de interacción` },
];
const audience = LINKEDIN.audience;

const pillars = [
  { cat: 'Marketing', icon: '📈', text: 'Estrategia, posicionamiento y crecimiento medido con números, no con intuición.' },
  { cat: 'Datos', icon: '📊', text: 'Métricas que importan, analítica y dashboards que ayudan a decidir.' },
  { cat: 'IA', icon: '🤖', text: 'Inteligencia artificial aplicada: herramientas, flujos y casos reales.' },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">// Marketing · Datos · IA</p>
        <h1>Decisiones de marketing <span class="gradient-text">guiadas por datos e IA</span></h1>
        <p class="lead">
          Soy Felipe López Miranda. Cada semana comparto en LinkedIn ideas prácticas para hacer un marketing más
          inteligente, medible y rentable con datos e inteligencia artificial.
        </p>
        <div class="cta">
          <a class="btn btn-linkedin" href={LINKEDIN_URL} target="_blank" rel="noopener">
            <LinkedInIcon /> Sígueme en LinkedIn
          </a>
          <a class="btn btn-ghost" href={featured.length ? '#destacados' : '/blog/'}>Ver mi contenido</a>
        </div>
      </div>
      <figure class="panel">
        <div class="panel-head">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <figcaption class="panel-title">Impresiones por mes · LinkedIn</figcaption>
        </div>
        <div class="chart" role="img" aria-label={`Impresiones mensuales en LinkedIn; máximo de ${formatNumber(maxMonth)} en ${monthName(peak.month)}`}>
          {
            months.map((m, i) => (
              <div class="col" tabindex="0">
                <span class="bar" style={`height:${(m.impressions / maxMonth) * 100}%;animation-delay:${i * 50}ms`} />
                <span class="tip">
                  <strong>{formatNumber(m.impressions)}</strong> impresiones<br />
                  {monthName(m.month)}
                </span>
              </div>
            ))
          }
        </div>
        <div class="axis" aria-hidden="true">
          {months.map((m) => <span>{monthName(m.month, 'narrow')}</span>)}
        </div>
        <div class="panel-foot">
          <span>total: <strong>{compact(LINKEDIN.impressions)}</strong></span>
          <span class="up">▲ pico {monthName(peak.month)}</span>
        </div>
      </figure>
    </div>
  </section>

  <section class="stats-band">
    <div class="container">
      <div class="stats">
        {
          stats.map((st) => (
            <div class="stat">
              <strong class="gradient-text">{st.value}</strong>
              <span class="label">{st.label}</span>
              <span class="sub">{st.sub}</span>
            </div>
          ))
        }
      </div>
      <p class="source">Fuente: LinkedIn Analytics · {fmtDate(LINKEDIN.period.from)} – {fmtDate(LINKEDIN.period.to)}</p>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">// Temas</p>
      <h2 class="section-title">De qué hablo</h2>
      <div class="pillars">
        {
          pillars.map((p) => (
            <a class="pillar" href={`/blog/?cat=${p.cat}`}>
              <span class="icon">{p.icon}</span>
              <h3>{p.cat}</h3>
              <p>{p.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="destacados">
    <div class="container">
      <p class="eyebrow">// Lo mejor en LinkedIn</p>
      <h2 class="section-title">Publicaciones con más alcance</h2>
      <div class="grid">{featured.map((post, i) => <LinkedInPostCard post={post} rank={i + 1} />)}</div>
      <p class="all">
        <a class="btn btn-ghost" href={`${LINKEDIN_URL}recent-activity/all/`} target="_blank" rel="noopener">
          Ver todas en LinkedIn →
        </a>
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">// Audiencia</p>
      <h2 class="section-title">Quién me lee</h2>
      <p class="intro">
        {formatNumber(LINKEDIN.followers)} profesionales siguen mi contenido, sobre todo del mundo de la publicidad y el
        marketing en Latinoamérica y España.
      </p>
      <div class="grid">
        <AudienceBars title="Sector" items={audience['Sector'] ?? []} />
        <AudienceBars title="Nivel de responsabilidad" items={audience['Nivel de responsabilidad'] ?? []} />
        <AudienceBars title="Ubicación" items={audience['Ubicación'] ?? []} />
      </div>
      <p class="source">Porcentaje de seguidores · Fuente: LinkedIn Analytics</p>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">// Blog</p>
      <h2 class="section-title">Artículos recientes</h2>
      <div class="grid">{latest.map((post) => <PostCard post={post} />)}</div>
      <p class="all"><a class="btn btn-ghost" href="/blog/">Ver todos los artículos →</a></p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="follow-band">
        <div>
          <p class="eyebrow">// Conversemos</p>
          <h2>¿Te interesa el marketing con datos e IA?</h2>
          <p>Sígueme en LinkedIn: ahí publico, respondo comentarios y converso con quienes trabajan en esto.</p>
        </div>
        <a class="btn btn-linkedin" href={LINKEDIN_URL} target="_blank" rel="noopener">
          <LinkedInIcon /> Seguir a Felipe
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 88px 0 56px; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  h1 { font-size: clamp(2.3rem, 5.5vw, 3.8rem); margin: 14px 0 18px; font-weight: 800; }
  .lead { color: var(--muted); font-size: 1.15rem; max-width: 560px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .panel { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; box-shadow: 0 20px 60px rgba(0, 212, 255, 0.12); }
  .panel-head { display: flex; align-items: center; gap: 6px; margin-bottom: 18px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border); }
  .panel-title { margin-left: 8px; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .chart { display: flex; align-items: flex-end; gap: 2px; height: 200px; border-bottom: 1px solid var(--border); }
  .col { position: relative; flex: 1; height: 100%; display: flex; align-items: flex-end; justify-content: center; outline: none; cursor: default; }
  .bar { width: 72%; border-radius: 4px 4px 0 0; background: var(--gradient); transform-origin: bottom; animation: grow 0.8s ease-out both; }
  .col:hover .bar, .col:focus .bar { filter: brightness(1.3); }
  .tip { position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 6px 10px; border-radius: 8px; background: var(--bg); border: 1px solid var(--border); font-family: var(--mono); font-size: 0.75rem; color: var(--muted); line-height: 1.4; text-align: center; display: none; pointer-events: none; z-index: 2; }
  .tip strong { color: var(--text); }
  .col:first-child .tip { left: 0; transform: none; }
  .col:last-child .tip { left: auto; right: 0; transform: none; }
  .col:hover .tip, .col:focus .tip { display: block; }
  .axis { display: flex; gap: 2px; margin-top: 6px; }
  .axis span { flex: 1; text-align: center; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); text-transform: uppercase; }
  .panel-foot { display: flex; justify-content: space-between; margin-top: 12px; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .panel-foot strong { color: var(--text); }
  .up { color: var(--accent); }
  @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .bar { animation: none; } }

  .stats-band { padding: 0; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .stat { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; display: flex; flex-direction: column; }
  .stat strong { font-size: 2.4rem; font-weight: 800; line-height: 1; font-family: var(--mono); white-space: nowrap; }
  .stat .label { color: var(--text); font-size: 0.95rem; margin-top: 10px; }
  .stat .sub { color: var(--muted); font-size: 0.8rem; font-family: var(--mono); margin-top: 2px; }
  .source { margin: 14px 0 0; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  .intro { color: var(--muted); max-width: 680px; margin: -12px 0 28px; }

  .pillars, .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .pillar { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; padding: 26px; border-radius: var(--radius); border: 1px solid var(--border); background: linear-gradient(180deg, var(--card), var(--bg-soft)); color: var(--text); transition: border-color 0.2s; }
  .pillar:hover { text-decoration: none; border-color: var(--brand-2); }
  .pillar .icon { font-size: 1.8rem; }
  .pillar h3 { margin: 0; }
  .pillar p { margin: 0 0 8px; color: var(--muted); font-size: 0.95rem; }
  .all { text-align: center; margin-top: 32px; }

  .follow-band { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 40px; border-radius: var(--radius); border: 1px solid var(--linkedin); background: radial-gradient(ellipse at top left, rgba(10, 102, 194, 0.25), transparent 60%), var(--card); }
  .follow-band h2 { margin: 8px 0; font-size: clamp(1.4rem, 3vw, 2rem); }
  .follow-band p:not(.eyebrow) { margin: 0; color: var(--muted); max-width: 560px; }

  @media (max-width: 860px) {
    .hero-grid, .pillars, .grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat strong { font-size: 1.8rem; }
    .hero { padding-top: 48px; }
    .follow-band { padding: 28px; }
  }
</style>
