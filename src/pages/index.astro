---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { LINKEDIN_URL, TOPICS, TAGLINE } from '../consts';
import { faqPage, podcast, droneimagen } from '../seo';
import { getPosts } from '../utils';
import { LINKEDIN, formatNumber, compact, POST_PAGES, postTitle } from '../data/linkedin';
import { ELEMENTOS, CAPAS, NIVELES } from '../lib/tabla';

const posts = await getPosts();
const guides = posts.filter((p) => p.data.exclusive).slice(0, 3);
const countBy = (cat: string) => posts.filter((p) => p.data.category === cat).length;
const latest = POST_PAGES.slice(0, 4);
const fmt = (d: string) => new Date(d).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', timeZone: 'UTC' });

// Íconos de línea (viewBox 0 0 48 48)
const icons = [
  '<circle cx="24" cy="24" r="18"/><circle cx="24" cy="24" r="11"/><circle cx="24" cy="24" r="4"/><path d="M24 24 40 8M34 8h6v6"/>',
  '<path d="M6 40h36"/><path d="M8 32l10-10 8 6 14-16"/><path d="M33 12h7v7"/>',
  '<path d="M24 4c1.5 9 5 12.5 14 14-9 1.5-12.5 5-14 14-1.5-9-5-12.5-14-14 9-1.5 12.5-5 14-14Z"/><path d="M38 30c.6 3.5 2 5 5.5 5.5-3.5.6-4.9 2-5.5 5.5-.6-3.5-2-4.9-5.5-5.5 3.5-.5 4.9-2 5.5-5.5Z"/>',
  '<path d="M8 20v8h6l16 10V10L14 20H8Z"/><path d="M14 28l3 12h5l-2-10"/><path d="M36 18c2 1.5 3 3.5 3 6s-1 4.5-3 6"/>',
];

const faqs = [
  {
    q: '¿Quién es Felipe López Miranda?',
    a: 'Es CMO & Growth Lead de TOCTOC, empresa de tecnología para el mercado inmobiliario en Chile. Periodista y Magíster en Dirección de Marketing y Gestión Comercial (UDP), escribe sobre performance marketing, datos e inteligencia artificial.',
  },
  {
    q: '¿Qué es la Tabla periódica del performance marketing?',
    a: `Es un recurso gratuito que ordena ${ELEMENTOS.length} conceptos de performance marketing en ${CAPAS.length} capas y ${NIVELES.length} niveles de madurez, como la tabla periódica. Cada concepto explica qué es, cómo se mide, el error más común y con qué otros conceptos se relaciona.`,
  },
  {
    q: '¿Sobre qué temas escribe?',
    a: 'Performance marketing (Meta Ads y Google Ads), datos y medición, inteligencia artificial aplicada a las campañas, y branding y contenido.',
  },
  {
    q: '¿Qué es Efecto Podcast?',
    a: 'Es el podcast que Felipe creó y conduce: conversaciones de alrededor de una hora con líderes, fundadores y expertos sobre marketing, negocios, emprendimiento e IA. Ya suma 39 episodios en YouTube y en efectopodcast.com.',
  },
  {
    q: '¿Cómo puedo contactarlo?',
    a: 'Por email a contacto@flopezmiranda.com o por LinkedIn, donde publica y conversa todas las semanas. Los datos están en la página de contacto.',
  },
];
---

<Base
  title="Inicio"
  fullTitle="Felipe López Miranda | Performance marketing, datos e IA"
  description={`${TAGLINE} Guías, la Tabla periódica del performance marketing y análisis semanales de Felipe López Miranda, CMO & Growth Lead en TOCTOC.`}
  schema={[faqPage(faqs), podcast, droneimagen]}
>
  <!-- Portada -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Felipe López Miranda · CMO & Growth Lead en TOCTOC</p>
        <h1>Performance marketing, datos e IA <span class="grad">explicados por alguien que los usa todos los días.</span></h1>
        <p class="intro">
          Guías, una tabla periódica con {ELEMENTOS.length} conceptos y análisis cada semana para equipos de marketing que quieren
          invertir mejor y decidir con evidencia.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/tabla/">Explorar la Tabla periódica →</a>
          <a class="btn" href="/guias/">Ver las guías</a>
        </div>
        <ul class="proof">
          <li><b>{formatNumber(LINKEDIN.followers)}</b> seguidores en LinkedIn</li>
          <li><b>39</b> episodios de Efecto Podcast</li>
          <li><b>{posts.length}</b> artículos y guías</li>
        </ul>
      </div>
      <figure class="portrait">
        <img src="/img/retrato.webp" alt="Retrato de Felipe López Miranda" width="1254" height="1254" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <!-- Recurso destacado: la Tabla -->
  <section class="section container">
    <a class="card feature" href="/tabla/">
      <figure>
        <img src="/tabla/og/tabla.png" alt={`Vista de la Tabla periódica del performance marketing: ${ELEMENTOS.length} elementos de colores ordenados por capa y nivel.`} width="1200" height="630" loading="lazy" decoding="async" />
      </figure>
      <div class="f-body">
        <p class="kicker">Recurso gratuito</p>
        <h2>Tabla periódica del performance marketing</h2>
        <p class="muted">
          {ELEMENTOS.length} conceptos en {CAPAS.length} capas y {NIVELES.length} niveles de madurez: del píxel y el CPA hasta el MMM y
          los agentes de IA. Cada uno con qué es, cómo se mide, el error más común y con qué elementos reacciona.
        </p>
        <span class="go">Explorar la tabla →</span>
      </div>
    </a>
  </section>

  <!-- Por dónde empezar -->
  {
    guides.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <h2>Por dónde empezar</h2>
          <a href="/guias/">Todas las guías →</a>
        </div>
        <p class="muted sub">Las guías más completas del sitio, escritas para leerlas con calma y volver a ellas.</p>
        <div class="grid3">{guides.map((post, i) => <PostCard post={post} index={i} />)}</div>
      </section>
    )
  }

  <!-- Temas -->
  <section id="temas" class="section container">
    <div class="section-head">
      <h2>Sobre qué escribo</h2>
      <a href="/blog/">Todos los escritos →</a>
    </div>
    <div class="topics">
      {
        TOPICS.map((t, i) => (
          <a class="card topic" href={`/blog/?cat=${encodeURIComponent(t.cat)}`}>
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 48 48" set:html={icons[i]} /></span>
            <h3>{t.name}</h3>
            <p class="muted">{t.text}</p>
            <span class="go">{countBy(t.cat)} escritos →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Lo último -->
  {
    latest.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <h2>Lo último en LinkedIn</h2>
          <a href="/linkedin/">Todas las publicaciones →</a>
        </div>
        <ol class="latest">
          {latest.map((p) => (
            <li>
              <time datetime={p.date}>{fmt(p.date)}</time>
              <a href={`/linkedin/${p.slug}/`}>{postTitle(p)}</a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- Quién soy -->
  <section class="section container">
    <div class="card about">
      <div>
        <p class="kicker">Quién escribe</p>
        <h2>Hola, soy <span class="grad">Felipe</span></h2>
        <p class="muted">
          Lidero marketing y crecimiento en TOCTOC, la empresa de tecnología para el mercado inmobiliario en Chile. Soy periodista y
          Magíster en Dirección de Marketing (UDP). Escribo desde lo que hago todos los días en campañas reales.
        </p>
        <div class="about-cta">
          <a class="btn" href="/sobre-mi/">Conoce más →</a>
          <a class="btn btn-primary" href={LINKEDIN_URL} target="_blank" rel="noopener">Sígueme en LinkedIn ↗</a>
        </div>
      </div>
      <dl class="nums">
        <div><dt>seguidores en LinkedIn</dt><dd class="num">{formatNumber(LINKEDIN.followers)}</dd></div>
        <div><dt>episodios de Efecto Podcast</dt><dd class="num">39</dd></div>
        <div><dt>impresiones al año en LinkedIn</dt><dd class="num">{compact(LINKEDIN.impressions)}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Proyectos -->
  <section id="proyectos" class="section container">
    <div class="section-head"><h2>Otros proyectos</h2></div>
    <div class="projects">
      <a class="card project" href="https://efectopodcast.com/" target="_blank" rel="noopener">
        <img src="/img/podcast-2.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" />
        <div>
          <p class="kicker">Podcast · Creador y conductor</p>
          <h3>Efecto Podcast ↗</h3>
          <p class="muted">Conversaciones de una hora con líderes y expertos sobre marketing, negocios e IA. 39 episodios.</p>
        </div>
      </a>
      <a class="card project" href="/droneimagen/">
        <img src="/img/drone/costanera.webp" alt="" width="1500" height="1125" loading="lazy" decoding="async" />
        <div>
          <p class="kicker">Banco de fotos · Creador</p>
          <h3>DroneImagen</h3>
          <p class="muted">Más de 1.100 fotografías aéreas de Chile, gratis y en alta resolución.</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section container narrow-wrap">
    <div class="section-head"><h2>Preguntas frecuentes</h2></div>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Portada */
  .hero { padding: 64px 0 40px; background: radial-gradient(ellipse 60% 70% at 10% 0%, rgba(var(--accent-rgb), 0.12), transparent 70%), radial-gradient(ellipse 50% 60% at 90% 30%, rgba(var(--accent2-rgb), 0.08), transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; align-items: center; }
  h1 { font-size: clamp(2rem, 4.4vw, 3.3rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.02em; margin: 14px 0 0; text-wrap: balance; }
  h1 .grad { display: inline; }
  .intro { color: var(--muted); font-size: 1.1rem; max-width: 560px; margin: 20px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .cta .btn { min-height: 46px; padding-inline: 20px; }
  .proof { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 26px 0 0; padding: 0; font-size: 0.85rem; color: var(--muted); }
  .proof b { font-family: var(--head); color: var(--text); }
  .portrait { margin: 0; border-radius: 24px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(11, 27, 58, 0.45); max-width: 420px; justify-self: end; }
  .portrait img { display: block; width: 100%; height: auto; }

  /* Tabla destacada */
  .feature { display: grid; grid-template-columns: 1.3fr 1fr; overflow: hidden; text-decoration: none; color: inherit; }
  .feature figure { margin: 0; background: #fff; border-right: 1px solid var(--line); }
  .feature img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .f-body { padding: 32px; display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  .f-body h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.15; }
  .f-body p.muted { margin: 0; }
  .feature:hover .go { text-decoration: underline; }

  .sub { margin: -8px 0 20px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

  /* Temas */
  .topics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .topic { padding: 22px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: inherit; }
  .topic:hover { border-color: var(--accent); }
  .icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 14px; background: rgba(var(--accent-rgb), 0.1); color: var(--accent); }
  .icon svg { width: 28px; height: 28px; }
  .topic h3 { font-size: 1.05rem; }
  .topic p.muted { margin: 0; font-size: 0.88rem; flex: 1; }
  .go { font-family: var(--head); font-weight: 600; font-size: 0.82rem; color: var(--accent); }

  /* Lo último */
  .latest { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 32px; }
  .latest li { display: flex; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .latest time { flex: none; width: 52px; font-size: 0.78rem; color: var(--faint); }
  .latest a { color: var(--text); font-family: var(--head); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
  .latest a:hover { color: var(--accent); }

  /* Quién soy */
  .about { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: center; padding: 32px; }
  .about h2 { font-size: 1.8rem; margin: 8px 0 10px; }
  .about p.muted { margin: 0 0 20px; max-width: 620px; }
  .about-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .nums { margin: 0; display: grid; gap: 18px; }
  .nums div { display: flex; flex-direction: column-reverse; }
  .nums dd { margin: 0; font-family: var(--head); font-weight: 800; font-size: 2rem; line-height: 1; }
  .nums dt { font-size: 0.82rem; color: var(--muted); margin-top: 4px; }

  /* Proyectos */
  .projects { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .project { display: grid; grid-template-columns: 160px 1fr; overflow: hidden; text-decoration: none; color: inherit; }
  .project img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .project > div { padding: 18px 20px; }
  .project h3 { font-size: 1.15rem; margin: 6px 0; }
  .project p.muted { margin: 0; font-size: 0.88rem; }
  .project:hover { border-color: var(--accent); }

  /* FAQ */
  .narrow-wrap { max-width: 820px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq summary { cursor: pointer; font-family: var(--head); font-weight: 600; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::after { content: '+'; color: var(--accent); font-size: 1.2rem; line-height: 1; }
  .faq details[open] summary::after { content: '–'; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq p { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; }

  @media (max-width: 960px) {
    .hero-grid, .feature, .about { grid-template-columns: 1fr; }
    .portrait { display: none; }
    .feature figure { border-right: 0; border-bottom: 1px solid var(--line); }
    .grid3 { grid-template-columns: 1fr 1fr; }
    .topics { grid-template-columns: repeat(2, 1fr); }
    .latest, .projects { grid-template-columns: 1fr; }
    .nums { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 36px; }
    .grid3, .topics { grid-template-columns: 1fr; }
    .f-body, .about { padding: 22px; }
    .project { grid-template-columns: 110px 1fr; }
    .nums dd { font-size: 1.5rem; }
  }
</style>
