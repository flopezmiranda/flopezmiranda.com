---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import AudienceBars from '../components/AudienceBars.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKEDIN_URL } from '../consts';
import { LINKEDIN, compact, formatNumber } from '../data/linkedin';
import { getPosts } from '../utils';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const featured = LINKEDIN.topPosts.slice(0, 5);

// Últimos 12 meses (el primer mes del export suele traer solo 1 o 2 días)
const months = LINKEDIN.monthly.slice(-12);
const maxMonth = Math.max(...months.map((m) => m.impressions));
const monthName = (key: string, style: 'short' | 'narrow' = 'short') =>
  new Date(`${key}-15`).toLocaleDateString('es-ES', { month: style, year: style === 'short' ? 'numeric' : undefined });
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const engagement = ((LINKEDIN.interactions / LINKEDIN.impressions) * 100).toLocaleString('es-CL', {
  maximumFractionDigits: 1,
});
const followersK = Math.floor(LINKEDIN.followers / 1000);

const stats = [
  { value: formatNumber(LINKEDIN.followers), label: 'Seguidores', sub: `+${formatNumber(LINKEDIN.newFollowers)} este año` },
  { value: compact(LINKEDIN.impressions), label: 'Impresiones', sub: 'últimos 12 meses' },
  { value: compact(LINKEDIN.reached), label: 'Personas alcanzadas', sub: 'profesionales únicos' },
  { value: `${engagement} %`, label: 'Tasa de interacción', sub: `${formatNumber(LINKEDIN.interactions)} interacciones` },
];
const audience = LINKEDIN.audience;
const marketingShare = (audience['Sector'] ?? []).slice(0, 2).reduce((s, i) => s + i.pct, 0);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="container">
    <!-- Presentación -->
    <section class="hero">
      <p class="label">Marketing · Datos · Inteligencia artificial</p>
      <h1 class="display">Felipe<br />López Miranda</h1>
      <p class="intro">
        Escribo sobre cómo tomar mejores decisiones de marketing con datos e inteligencia artificial. Cada semana lo
        comparto en LinkedIn, donde me siguen más de {followersK} mil profesionales del marketing y la publicidad.
      </p>
      <p class="cta">
        <a class="arrow-link" href={LINKEDIN_URL} target="_blank" rel="noopener">Seguir en LinkedIn ↗</a>
        <a href="/sobre-mi/">Sobre mí</a>
      </p>
    </section>

    <!-- Cifras -->
    <section class="stats-section" aria-label="Cifras en LinkedIn">
      <dl class="stats">
        {
          stats.map((s) => (
            <div>
              <dt class="label">{s.label}</dt>
              <dd class="value serif num">{s.value}</dd>
              <dd class="sub">{s.sub}</dd>
            </div>
          ))
        }
      </dl>
      <p class="note">Fuente: LinkedIn Analytics, {fmtDate(LINKEDIN.period.from)} – {fmtDate(LINKEDIN.period.to)}.</p>
    </section>

    <!-- Lo más leído -->
    <section>
      <div class="section-head">
        <h2>Lo más leído</h2>
        <a href={`${LINKEDIN_URL}recent-activity/all/`} target="_blank" rel="noopener">Todo en LinkedIn ↗</a>
      </div>
      {featured.map((post, i) => <LinkedInPostCard post={post} rank={i + 1} />)}
    </section>

    <!-- Sobre mí -->
    <section>
      <div class="section-head">
        <h2>Sobre mí</h2>
        <a href="/sobre-mi/">Más →</a>
      </div>
      <div class="about">
        <p class="about-lead serif">
          <!-- ✏️ Reemplaza este texto con tu presentación real. -->
          Me interesa el punto donde el marketing deja de ser intuición y empieza a ser evidencia.
        </p>
        <p class="about-body">
          En LinkedIn comparto lo que aprendo sobre plataformas publicitarias, funnels, analítica e inteligencia
          artificial aplicada, con ejemplos concretos y sin humo.
        </p>
      </div>
    </section>

    <!-- Audiencia -->
    <section>
      <div class="section-head">
        <h2>Quién me lee</h2>
        <span class="label">Seguidores en LinkedIn</span>
      </div>
      <p class="audience-lead">
        El <strong>{marketingShare} %</strong> de quienes me siguen trabaja en publicidad o marketing, y el contenido
        llega a {compact(LINKEDIN.reached)} profesionales al año.
      </p>

      <figure class="chart-fig">
        <figcaption class="label">Impresiones por mes</figcaption>
        <div class="chart" role="img" aria-label={`Impresiones mensuales en LinkedIn; máximo de ${formatNumber(maxMonth)}`}>
          {
            months.map((m) => (
              <div class="col" tabindex="0">
                <span class:list={['bar', { peak: m.impressions === maxMonth }]} style={`height:${(m.impressions / maxMonth) * 100}%`} />
                <span class="tip num">
                  {formatNumber(m.impressions)}
                  <br />
                  {monthName(m.month)}
                </span>
              </div>
            ))
          }
        </div>
        <div class="axis" aria-hidden="true">{months.map((m) => <span>{monthName(m.month, 'narrow')}</span>)}</div>
      </figure>

      <div class="audience-grid">
        <AudienceBars title="Sector" items={audience['Sector'] ?? []} />
        <AudienceBars title="Nivel" items={audience['Nivel de responsabilidad'] ?? []} />
        <AudienceBars title="Ubicación" items={audience['Ubicación'] ?? []} />
      </div>
    </section>

    <!-- Escritos -->
    {
      latest.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Escritos</h2>
            <a href="/blog/">Todos →</a>
          </div>
          {latest.map((post) => (
            <PostCard post={post} />
          ))}
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero { padding-top: 72px; }
  .hero .display { margin: 22px 0 36px; }
  .intro { max-width: 620px; font-size: 1.25rem; line-height: 1.55; color: var(--muted); margin: 0; }
  .cta { display: flex; gap: 32px; margin: 36px 0 0; font-size: 1.05rem; }

  .stats-section { padding-top: 88px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-top: 1px solid var(--text); }
  .stats > div { padding: 22px 24px 0 0; }
  .stats > div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  dd { margin: 0; }
  .value { font-size: clamp(2.6rem, 5vw, 3.8rem); line-height: 1; margin: 14px 0 8px; white-space: nowrap; }
  .sub { font-size: 0.82rem; color: var(--muted); }

  .about { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; padding-top: 28px; }
  .about-lead { font-size: clamp(1.8rem, 3.5vw, 2.5rem); line-height: 1.15; margin: 0; }
  .about-body { color: var(--muted); margin: 0; }

  .audience-lead { font-size: 1.2rem; max-width: 640px; margin: 28px 0 48px; }
  .chart-fig { margin: 0 0 56px; }
  .chart { display: flex; align-items: flex-end; gap: 6px; height: 180px; margin-top: 16px; border-bottom: 1px solid var(--text); }
  .col { position: relative; flex: 1; height: 100%; display: flex; align-items: flex-end; outline: none; }
  .bar { width: 100%; background: var(--line); border-radius: 2px 2px 0 0; transition: background 0.2s; }
  .bar.peak { background: var(--text); }
  .col:hover .bar, .col:focus .bar { background: var(--accent); }
  .tip { position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%); display: none; white-space: nowrap; padding: 6px 10px; background: var(--text); color: var(--bg); font-size: 0.75rem; line-height: 1.4; text-align: center; border-radius: 4px; pointer-events: none; z-index: 2; }
  .col:first-child .tip { left: 0; transform: none; }
  .col:last-child .tip { left: auto; right: 0; transform: none; }
  .col:hover .tip, .col:focus .tip { display: block; }
  .axis { display: flex; gap: 6px; margin-top: 8px; }
  .axis span { flex: 1; text-align: center; font-size: 0.72rem; color: var(--muted); text-transform: uppercase; }
  .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }

  @media (max-width: 820px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats > div:nth-child(3) { padding-left: 0; border-left: 0; }
    .stats > div:nth-child(n + 3) { margin-top: 28px; border-top: 1px solid var(--line); }
    .about, .audience-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 40px; }
    .stats > div + div { padding-left: 16px; }
    .stats > div { padding-right: 8px; }
    .value { font-size: 2.2rem; }
    .chart, .axis { gap: 3px; }
  }
</style>
