---
import Base from '../layouts/Base.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import AudienceBars from '../components/AudienceBars.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKEDIN_URL, SOCIAL, TOPICS } from '../consts';
import { LINKEDIN, compact, formatNumber } from '../data/linkedin';

const featured = LINKEDIN.topPosts.slice(0, 8);
const followersK = Math.floor(LINKEDIN.followers / 1000);
const audience = LINKEDIN.audience;
const marketingShare = (audience['Sector'] ?? []).slice(0, 2).reduce((s, i) => s + i.pct, 0);
const months = LINKEDIN.monthly.slice(-12);
const maxMonth = Math.max(...months.map((m) => m.impressions));

const chips = [
  { name: 'TOCTOC', sub: 'CMO & Growth Lead' },
  { name: 'Efecto Podcast', sub: 'Creador y conductor' },
  { name: 'DroneImagen', sub: 'Creador · +1.100 fotos aéreas' },
  { name: 'LinkedIn', sub: `${formatNumber(LINKEDIN.followers)} seguidores` },
  { name: 'Universidad Diego Portales', sub: 'Magíster en Dirección de Marketing' },
  { name: 'Florida International University', sub: 'Posgrado en Transformación Digital' },
  { name: 'Universidad Adolfo Ibáñez', sub: 'Posgrado en Gestión Digital' },
  { name: 'Periodista', sub: 'U. Academia de Humanismo Cristiano' },
];

const faqs = [
  {
    q: '¿Quién es Felipe López Miranda?',
    a: 'Es CMO & Growth Lead de TOCTOC, empresa de tecnología para el mercado inmobiliario en Chile. Periodista y Magíster en Dirección de Marketing y Gestión Comercial (UDP), escribe sobre marketing, datos e inteligencia artificial.',
  },
  {
    q: '¿Sobre qué temas escribe?',
    a: 'Performance marketing (Meta Ads y Google Ads), datos y analítica, inteligencia artificial aplicada al marketing, y branding y contenido.',
  },
  {
    q: '¿Qué es Efecto Podcast?',
    a: 'Es el podcast que Felipe creó y conduce: conversaciones de alrededor de una hora con líderes, fundadores y expertos sobre marketing, negocios, emprendimiento e IA. Ya suma 39 episodios en YouTube y en efectopodcast.com.',
  },
  {
    q: '¿Qué es DroneImagen?',
    a: 'Es un banco de fotos gratis con más de 1.100 fotografías aéreas de Chile tomadas con drone por Felipe, descargables en alta resolución para proyectos personales y comerciales.',
  },
  {
    q: '¿Cómo puedo contactarlo?',
    a: 'La mejor forma es escribirle por LinkedIn, donde publica y conversa todas las semanas.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Felipe López Miranda',
      url: 'https://flopezmiranda.com/',
      image: 'https://flopezmiranda.com/img/retrato.webp',
      jobTitle: 'CMO & Growth Lead',
      worksFor: { '@type': 'Organization', name: 'TOCTOC', url: 'https://www.toctoc.com' },
      sameAs: [LINKEDIN_URL, SOCIAL.instagram, 'https://efectopodcast.com/', 'https://www.droneimagen.cl/'].filter(Boolean),
      knowsAbout: ['Marketing digital', 'Performance marketing', 'Analítica', 'Inteligencia artificial', 'Branding'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Portada -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Marketing · Datos · Inteligencia artificial</p>
        <h1><span>Felipe</span><span class="grad">López Miranda</span></h1>
        <div class="bars" aria-hidden="true">{months.map((m) => <span style={`height:${20 + (m.impressions / maxMonth) * 80}%`} />)}</div>
        <p class="intro">
          CMO & Growth Lead en TOCTOC y creador de Efecto Podcast. Escribo sobre marketing, datos e IA para más de
          {' '}{followersK} mil profesionales en LinkedIn.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={LINKEDIN_URL} target="_blank" rel="noopener">▸ Sígueme en LinkedIn</a>
          <a class="btn" href="https://efectopodcast.com/" target="_blank" rel="noopener">Escucha Efecto Podcast</a>
        </div>
        <dl class="stats">
          <div><dd class="num">{formatNumber(LINKEDIN.followers)}</dd><dt>seguidores</dt></div>
          <div><dd class="num">{compact(LINKEDIN.impressions).replace(' ', '')}</dd><dt>impresiones al año</dt></div>
          <div><dd class="num">39</dd><dt>episodios</dt></div>
        </dl>
      </div>

      <div class="stack">
        <figure class="ph back-1"><img src="/img/podcast-1.webp" alt="" /></figure>
        <figure class="ph back-2"><img src="/img/retrato.webp" alt="" /></figure>
        <figure class="ph front">
          <img src="/img/podcast-2.webp" alt="Felipe conversando en Efecto Podcast" />
          <figcaption>
            <span class="kicker">Efecto Podcast · 39 episodios</span>
            <strong>Conversaciones sobre marketing, negocios y creatividad</strong>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Cinta -->
  <div class="strip">
    <p class="kicker center">Dónde me encuentras</p>
    <div class="marquee">
      <div class="track">
        {
          [0, 1].map(() =>
            chips.map((c) => (
              <div class="chip">
                <strong>{c.name}</strong>
                <span>{c.sub}</span>
              </div>
            )),
          )
        }
      </div>
    </div>
  </div>

  <!-- Lo más leído -->
  <section class="section container">
    <div class="section-head">
      <h2>Lo más leído en LinkedIn</h2>
      <a href={`${LINKEDIN_URL}recent-activity/all/`} target="_blank" rel="noopener">Ver todo →</a>
    </div>
    <div class="grid4">{featured.map((post, i) => <LinkedInPostCard post={post} rank={i + 1} />)}</div>
  </section>

  <!-- Proyectos -->
  <section id="proyectos" class="section container">
    <div class="section-head"><h2>Proyectos</h2></div>
    <div class="projects">
      <a class="card project pod" href="https://efectopodcast.com/" target="_blank" rel="noopener">
        <figure><img src="/img/podcast-2.webp" alt="Felipe en el estudio de Efecto Podcast" loading="lazy" /></figure>
        <div class="p-body">
          <img class="pod-logo" src="/img/efecto-podcast-logo.png" alt="" width="44" height="36" />
          <p class="kicker">Podcast · Creador y conductor</p>
          <h3>Efecto Podcast</h3>
          <p class="muted">
            Entrevistas de una hora con líderes, fundadores y expertos sobre marketing, negocios, emprendimiento e IA.
          </p>
          <ul class="mini-stats"><li><b>39</b> episodios</li><li><b>17</b> invitados</li><li><b>32 h</b> de conversación</li></ul>
          <span class="go">efectopodcast.com →</span>
        </div>
      </a>
      <a class="card project" href="https://www.droneimagen.cl/" target="_blank" rel="noopener">
        <figure class="drone-art" aria-hidden="true">
          <!-- Ilustración provisoria: reemplazar por una foto real de droneimagen.cl -->
          <svg viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3caeea" /><stop offset="0.7" stop-color="#7c91eb" /><stop offset="1" stop-color="#e15c96" /></linearGradient>
            </defs>
            <rect width="600" height="340" fill="url(#sky)" />
            <circle cx="470" cy="90" r="38" fill="#ffd60a" />
            <path d="M0 220 120 120 200 190 300 90 420 200 520 140 600 200V340H0Z" fill="#5a3fb0" opacity="0.85" />
            <path d="M0 260 90 210 180 250 290 180 400 250 500 220 600 260V340H0Z" fill="#1b1440" />
            <g fill="#090619" transform="translate(300 60)"><rect x="-14" y="-5" width="28" height="10" rx="4" /><path d="M-14 0h-22M14 0h22" stroke="#090619" stroke-width="3" /><ellipse cx="-40" cy="-3" rx="14" ry="3" /><ellipse cx="40" cy="-3" rx="14" ry="3" /></g>
          </svg>
        </figure>
        <div class="p-body">
          <p class="kicker">Banco de fotos · Creador</p>
          <h3>DroneImagen</h3>
          <p class="muted">Más de 1.100 fotografías aéreas de Chile, gratis y en alta resolución, para proyectos personales y comerciales.</p>
          <ul class="mini-stats"><li><b>+1.100</b> fotos</li><li><b>31</b> lugares</li><li><b>Gratis</b></li></ul>
          <span class="go">droneimagen.cl →</span>
        </div>
      </a>
      <a class="card project" href="https://www.toctoc.com" target="_blank" rel="noopener">
        <figure><img src="/img/evento-20k.webp" alt="Felipe en el escenario celebrando 20 mil seguidores en LinkedIn" loading="lazy" class="top" /></figure>
        <div class="p-body">
          <p class="kicker">Hoy · CMO & Growth Lead</p>
          <h3>TOCTOC</h3>
          <p class="muted">
            Lidero marketing y crecimiento en la empresa de tecnología para el mercado inmobiliario en Chile: branding,
            datos y performance.
          </p>
          <span class="go">toctoc.com →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Temas -->
  <section class="section container">
    <div class="section-head"><h2>Sobre qué escribo</h2></div>
    <div class="topics">
      {
        TOPICS.map((t, i) => (
          <article class="card topic">
            <p class="kicker">Tema {String(i + 1).padStart(2, '0')}</p>
            <h3>{t.name}</h3>
            <p class="muted">{t.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Audiencia -->
  <section class="section container">
    <div class="section-head"><h2>Quién me lee</h2></div>
    <div class="aud-intro card">
      <p class="big num grad">{marketingShare} %</p>
      <p>
        de quienes me siguen trabaja en <strong>publicidad o marketing</strong>. El contenido llegó a{' '}
        <strong>{compact(LINKEDIN.reached)} profesionales</strong> en el último año.
      </p>
    </div>
    <div class="aud-grid">
      <AudienceBars title="Sector" items={audience['Sector'] ?? []} />
      <AudienceBars title="Nivel" items={audience['Nivel de responsabilidad'] ?? []} />
      <AudienceBars title="Ubicación" items={audience['Ubicación'] ?? []} />
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section container narrow-wrap">
    <div class="section-head"><h2>Preguntas frecuentes</h2></div>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* Portada */
  .hero { position: relative; padding: 64px 0 56px; background: radial-gradient(ellipse 60% 70% at 15% 0%, rgba(225, 92, 150, 0.28), transparent 70%), radial-gradient(ellipse 50% 60% at 90% 30%, rgba(60, 174, 234, 0.18), transparent 70%); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  h1 { display: flex; flex-direction: column; font-size: clamp(2.6rem, 6.4vw, 4.6rem); font-weight: 800; line-height: 1; text-transform: uppercase; letter-spacing: -0.02em; margin: 16px 0 18px; }
  .bars { display: flex; align-items: flex-end; gap: 4px; height: 26px; width: 150px; }
  .bars span { flex: 1; border-radius: 2px; background: var(--gradient); background-size: 150px 100%; background-attachment: local; }
  .bars span:nth-child(3n) { background: var(--pink); }
  .bars span:nth-child(3n + 1) { background: var(--violet); }
  .bars span:nth-child(3n + 2) { background: var(--lavender); }
  .intro { color: var(--muted); max-width: 500px; margin: 18px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .stats { display: flex; gap: 32px; margin: 32px 0 0; }
  .stats dd { margin: 0; font-family: var(--head); font-weight: 700; font-size: 1.6rem; line-height: 1; }
  .stats dt { font-size: 0.72rem; color: var(--muted); margin-top: 4px; }

  .stack { position: relative; height: 400px; }
  .ph { position: absolute; margin: 0; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7); }
  .ph img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .back-1 { width: 55%; height: 46%; top: 0; left: 0; opacity: 0.55; }
  .back-2 { width: 34%; height: 56%; top: 0; right: 0; opacity: 0.6; }
  .front { width: 82%; height: 66%; left: 9%; bottom: 0; border: 2px solid rgba(192, 114, 231, 0.6); box-shadow: 0 30px 80px -20px rgba(192, 114, 231, 0.55); }
  .front figcaption { position: absolute; inset: auto 0 0 0; padding: 40px 16px 14px; background: linear-gradient(transparent, rgba(9, 6, 25, 0.95)); display: flex; flex-direction: column; gap: 4px; }
  .front figcaption .kicker { font-size: 0.62rem; }
  .front strong { font-family: var(--head); font-size: 0.95rem; line-height: 1.25; }

  /* Cinta */
  .strip { padding: 28px 0 8px; }
  .center { text-align: center; color: var(--faint); margin-bottom: 14px; }
  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: 12px; width: max-content; animation: scroll 50s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes scroll { to { transform: translateX(calc(-50% - 6px)); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
  .chip { display: flex; flex-direction: column; padding: 10px 16px; min-width: 210px; border-radius: 10px; background: var(--card); border: 1px solid var(--line); }
  .chip strong { font-family: var(--head); font-size: 0.82rem; }
  .chip span { font-size: 0.72rem; color: var(--muted); }

  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

  /* Proyectos */
  .projects { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 16px; }
  .project { display: flex; flex-direction: column; overflow: hidden; }
  .project figure { margin: 0; aspect-ratio: 16 / 9; overflow: hidden; }
  .project figure img, .project figure svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project figure img.top { object-position: center 20%; }
  .p-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .p-body h3 { font-size: 1.3rem; }
  .p-body p.muted { margin: 0; font-size: 0.9rem; }
  .pod { background: linear-gradient(160deg, #1d1145, var(--card)); }
  .pod-logo { width: 40px; height: auto; }
  .mini-stats { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 6px 0 0; padding: 0; font-size: 0.8rem; color: var(--muted); }
  .mini-stats b { font-family: var(--head); color: var(--text); }
  .go { margin-top: auto; padding-top: 8px; font-family: var(--head); font-weight: 600; font-size: 0.82rem; color: var(--violet); }

  /* Temas */
  .topics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .topic { padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .topic .kicker { font-size: 0.62rem; }
  .topic h3 { font-size: 1.05rem; }
  .topic p.muted { margin: 0; font-size: 0.88rem; }

  /* Audiencia */
  .aud-intro { display: flex; align-items: center; gap: 24px; padding: 20px 24px; margin-bottom: 16px; }
  .aud-intro p { margin: 0; color: var(--muted); }
  .aud-intro strong { color: var(--text); }
  .big { font-family: var(--head); font-weight: 800; font-size: 3rem; line-height: 1; white-space: nowrap; }
  .aud-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

  /* FAQ */
  .narrow-wrap { max-width: 820px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq summary { cursor: pointer; font-family: var(--head); font-weight: 600; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::after { content: '+'; color: var(--violet); font-size: 1.2rem; line-height: 1; }
  .faq details[open] summary::after { content: '–'; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq p { margin: 10px 0 0; color: var(--muted); font-size: 0.92rem; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .stack { height: 340px; }
    .grid4, .topics { grid-template-columns: repeat(2, 1fr); }
    .projects, .aud-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 36px; }
    .stack { height: 280px; }
    .stats { gap: 22px; }
    .stats dd { font-size: 1.35rem; }
    .grid4 { grid-template-columns: 1fr; }
    .topics { grid-template-columns: 1fr; }
    .aud-intro { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>
