---
import Base from '../layouts/Base.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import AudienceBars from '../components/AudienceBars.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKEDIN_URL, PROJECTS, TOPICS } from '../consts';
import { LINKEDIN, compact, formatNumber } from '../data/linkedin';

const featured = LINKEDIN.topPosts.slice(0, 5);
const followersK = Math.floor(LINKEDIN.followers / 1000);
const audience = LINKEDIN.audience;
const marketingShare = (audience['Sector'] ?? []).slice(0, 2).reduce((s, i) => s + i.pct, 0);
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const stats = [
  { value: formatNumber(LINKEDIN.followers), label: 'seguidores' },
  { value: compact(LINKEDIN.impressions), label: 'impresiones al año' },
  { value: compact(LINKEDIN.reached), label: 'profesionales alcanzados' },
];
const strip = [
  { src: '/img/retrato.webp', alt: 'Retrato de Felipe López Miranda' },
  { src: '/img/podcast-2.webp', alt: 'Felipe conversando en un podcast' },
  { src: '/img/evento-20k.webp', alt: 'Felipe en el escenario celebrando 20 mil seguidores en LinkedIn' },
  { src: '/img/podcast-1.webp', alt: 'Felipe en el estudio de grabación' },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Portada -->
  <section class="hero container">
    <h1 class="display">Marketing con <em>datos</em><span class="arrow" aria-hidden="true">⟶</span></h1>
    <p class="intro">
      Soy Felipe López Miranda. Escribo sobre marketing, datos e inteligencia artificial para más de {followersK} mil
      profesionales en LinkedIn.
    </p>
  </section>
  <div class="strip container">
    {strip.map((img) => <figure><img class="photo" src={img.src} alt={img.alt} loading="eager" /></figure>)}
  </div>

  <!-- Acerca de -->
  <section class="band ink about-band">
    <div class="container about">
      <div>
        <h2 class="title-xl">Acerca de<br /><em>Felipe</em></h2>
        <dl class="stats">
          {
            stats.map((s) => (
              <div>
                <dd class="serif num">{s.value}</dd>
                <dt>{s.label}</dt>
              </div>
            ))
          }
        </dl>
        <p class="note">LinkedIn Analytics · {fmtDate(LINKEDIN.period.from)} – {fmtDate(LINKEDIN.period.to)}</p>
      </div>
      <div class="about-right">
        <figure class="portrait"><img class="photo" src="/img/retrato.webp" alt="" loading="lazy" /></figure>
        <div class="about-text">
          <!-- ✏️ Texto provisorio: reemplazar con tu biografía real -->
          <p>
            Me interesa el punto donde el marketing deja de ser intuición y empieza a ser evidencia. En LinkedIn comparto
            lo que aprendo sobre plataformas publicitarias, funnels, analítica e IA aplicada.
          </p>
          <p>
            Además conduzco <a href="https://efectopodcast.com/" target="_blank" rel="noopener">EfectoPodcast</a> y estoy
            detrás de <a href="https://www.droneimagen.cl/" target="_blank" rel="noopener">DroneImagen</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lo más leído -->
  <section class="band container">
    <div class="head-row">
      <h2 class="title-xl">Lo más <em>leído</em></h2>
      <span class="big-arrow" aria-hidden="true">↓</span>
    </div>
    <div class="list">{featured.map((post, i) => <LinkedInPostCard post={post} rank={i + 1} />)}</div>
    <p class="more"><a class="pill" href={`${LINKEDIN_URL}recent-activity/all/`} target="_blank" rel="noopener">Ver todo en LinkedIn ↗</a></p>
  </section>

  <!-- Proyectos -->
  {
    PROJECTS.map((p, i) => (
      <section class:list={['band', 'project', { soft: i % 2 === 0 }]}>
        <div class="container project-grid">
          <div class="project-text">
            <h3 class="title-l serif">
              {p.name}
              <em>{p.nameEm}</em>
            </h3>
            <span class="tag">{p.tag}</span>
            <ol class="steps">
              <li>
                <span class="n serif">01</span>
                <div>
                  <strong>Qué es</strong>
                  <p>{p.what}</p>
                </div>
              </li>
              <li>
                <span class="n serif">02</span>
                <div>
                  <strong>Resultado</strong>
                  <p>{p.result}</p>
                </div>
              </li>
            </ol>
            <a class="pill" href={p.url} target="_blank" rel="noopener">
              Visitar {p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗
            </a>
          </div>
          <div class="project-media">
            {p.images.length > 0 ? (
              p.images.map((src) => (
                <figure>
                  <img class="photo" src={src} alt={`${p.name}${p.nameEm}`} loading="lazy" />
                </figure>
              ))
            ) : (
              <figure class="placeholder">
                <span>Imagen de {p.name}{p.nameEm} — pendiente</span>
              </figure>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <!-- Temas -->
  <section class="band container">
    <h2 class="title-xl">De qué <em>hablo</em></h2>
    <p class="lead">Marketing que se puede medir, explicado con ejemplos reales.</p>
    <ul class="topics">{TOPICS.map((t) => <li class="pill">{t}</li>)}</ul>
  </section>

  <!-- Hitos -->
  <section class="band ink">
    <div class="container milestone">
      <figure class="milestone-photo">
        <img class="photo" src="/img/evento-20k.webp" alt="Felipe en el escenario del evento por los 20 mil seguidores" loading="lazy" />
      </figure>
      <div>
        <h2 class="title-xl">Hitos y <em>escenarios</em></h2>
        <ul class="milestones">
          <li>
            <span class="label">Evento en vivo</span>
            <strong class="serif">Celebrando 20K seguidores en LinkedIn</strong>
            <!-- ✏️ Agrega fecha y lugar del evento -->
          </li>
          <li>
            <span class="label">Hoy</span>
            <strong class="serif">{formatNumber(LINKEDIN.followers)} seguidores</strong>
          </li>
          <li>
            <span class="label">Podcast</span>
            <strong class="serif">EfectoPodcast</strong>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Audiencia -->
  <section class="band soft">
    <div class="container">
      <h2 class="title-xl">Quién me <em>lee</em></h2>
      <p class="lead">
        El {marketingShare} % de quienes me siguen trabaja en publicidad o marketing, sobre todo en Latinoamérica y España.
      </p>
      <div class="audience-grid">
        <AudienceBars title="Sector" items={audience['Sector'] ?? []} />
        <AudienceBars title="Nivel" items={audience['Nivel de responsabilidad'] ?? []} />
        <AudienceBars title="Ubicación" items={audience['Ubicación'] ?? []} />
      </div>
    </div>
  </section>
</Base>

<style>
  section.hero { padding-top: 56px; }
  .hero { padding-top: 56px; padding-bottom: 48px; text-align: center; }
  .display { font-size: clamp(3.2rem, 10vw, 7.5rem); }
  .arrow { font-family: var(--sans); font-weight: 200; font-size: 0.5em; vertical-align: middle; margin-left: 0.3em; }
  .intro { max-width: 560px; margin: 28px auto 0; font-size: 1.15rem; color: var(--muted); }

  .strip { display: grid; grid-template-columns: 1fr 1.6fr 0.8fr 1.6fr; gap: 10px; height: 340px; }
  .strip figure { margin: 0; overflow: hidden; }

  .about-band { margin-top: 110px; }
  .about { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; }
  .stats { display: flex; flex-wrap: wrap; gap: 36px; margin: 56px 0 0; }
  .stats dd { margin: 0; font-size: 3rem; line-height: 1; }
  .stats dt { font-size: 0.85rem; color: var(--muted); margin-top: 6px; }
  .note { color: var(--muted); }
  .about-right { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; }
  .portrait { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .about-text p { margin: 0 0 16px; font-size: 0.98rem; color: #d9d9d9; }
  .about-text a { color: #fff; text-decoration-color: #666; }

  .head-row { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid var(--ink); padding-bottom: 20px; }
  .big-arrow { font-size: 3rem; font-weight: 200; line-height: 1; }
  .more { margin: 40px 0 0; text-align: center; }

  .project-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 64px; align-items: center; }
  .title-l { font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 400; line-height: 1; margin: 0 0 14px; }
  .title-l em { font-style: italic; }
  .tag { display: inline-block; font-size: 0.75rem; padding: 3px 12px; border: 1px solid var(--ink); border-radius: 999px; }
  .steps { list-style: none; margin: 40px 0; padding: 0; display: flex; flex-direction: column; gap: 28px; }
  .steps li { display: grid; grid-template-columns: 56px 1fr; gap: 12px; }
  .steps .n { font-size: 2rem; line-height: 1; }
  .steps strong { font-weight: 500; }
  .steps p { margin: 4px 0 0; color: var(--muted); font-size: 0.95rem; }
  .project-media { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .project-media figure { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .project-media figure:only-child { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
  .placeholder { display: flex; align-items: center; justify-content: center; background: repeating-linear-gradient(45deg, #e6e6e4 0 1px, transparent 1px 14px), var(--bg-soft); border: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }

  .lead { font-size: 1.15rem; color: var(--muted); max-width: 620px; margin: 18px 0 40px; }
  .topics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .topics .pill { justify-content: center; padding: 12px 18px; }
  .topics .pill:hover { background: transparent; color: inherit; border-color: currentColor; }

  .milestone { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 72px; align-items: center; }
  .milestone-photo { margin: 0; aspect-ratio: 3 / 4; overflow: hidden; }
  .milestones { list-style: none; margin: 48px 0 0; padding: 0; }
  .milestones li { display: flex; flex-direction: column; gap: 4px; padding: 20px 0; border-top: 1px solid var(--line); }
  .milestones .label { color: var(--muted); }
  .milestones strong { font-weight: 400; font-size: 1.8rem; line-height: 1.15; }

  .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }

  @media (max-width: 900px) {
    .strip { grid-template-columns: 1fr 1fr; height: auto; }
    .strip figure { aspect-ratio: 1; }
    .about, .about-right, .project-grid, .milestone, .audience-grid { grid-template-columns: 1fr; gap: 40px; }
    .topics { grid-template-columns: repeat(2, 1fr); }
    .band { padding: 72px 0; }
    .about-band { margin-top: 72px; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 32px; }
    .stats dd { font-size: 2.3rem; }
    .project-media { grid-template-columns: 1fr; }
    .project-media figure { aspect-ratio: 16 / 10; }
  }
</style>
