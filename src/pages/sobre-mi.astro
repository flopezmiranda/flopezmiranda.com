---
import Base from '../layouts/Base.astro';
import { SOCIAL, LINKEDIN_URL } from '../consts';
import { LINKEDIN, formatNumber } from '../data/linkedin';
---

<Base title="Sobre mí" description="Quién es Felipe López Miranda y de qué escribe.">
  <div class="container">
    <h1 class="display">Sobre mí</h1>
    <div class="layout">
      <p class="lead serif">
        <!-- ✏️ Reemplaza con tu presentación: a qué te dedicas y qué te mueve. -->
        Soy Felipe López Miranda y escribo sobre marketing, datos e inteligencia artificial.
      </p>
      <div class="prose">
        <p>
          <!-- ✏️ Reemplaza con tu biografía: experiencia, empresas, logros. -->
          Me interesa la intersección entre el marketing, los datos y la IA: cómo las marcas pueden dejar de decidir por
          intuición y empezar a decidir con evidencia.
        </p>
        <p>
          Comparto ese aprendizaje en LinkedIn, donde me siguen {formatNumber(LINKEDIN.followers)} profesionales,
          principalmente de agencias, equipos de marketing y empresas de Latinoamérica y España.
        </p>
        <h2>De qué escribo</h2>
        <ul>
          <li><strong>Marketing:</strong> estrategia, plataformas publicitarias y funnels.</li>
          <li><strong>Datos:</strong> métricas, analítica y medición.</li>
          <li><strong>IA:</strong> herramientas y casos de uso prácticos.</li>
        </ul>
        <h2>Contacto</h2>
        <p>
          La mejor forma de contactarme es por <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>.
          {SOCIAL.email && <>También puedes escribirme a <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>.</>}
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .display { margin: 48px 0 56px; }
  .layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; border-top: 1px solid var(--text); padding-top: 32px; }
  .lead { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.15; margin: 0; }
  .prose > :first-child { margin-top: 0; }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; gap: 32px; } }
</style>
