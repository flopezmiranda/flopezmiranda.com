---
import Base from '../layouts/Base.astro';
import { LINKEDIN_URL } from '../consts';
import { LINKEDIN, formatNumber } from '../data/linkedin';
---

<Base title="Sobre mí" description="Quién es Felipe López Miranda: CMO & Growth Lead en TOCTOC, creador de Efecto Podcast y DroneImagen.">
  <section class="section container about">
    <figure class="photo"><img src="/img/retrato.webp" alt="Retrato de Felipe López Miranda" /></figure>
    <div>
      <p class="kicker">Sobre mí</p>
      <h1>Hola, soy <span class="grad">Felipe</span></h1>
      <div class="prose">
        <p>
          Soy CMO & Growth Lead en <strong>TOCTOC</strong>, la empresa de tecnología para el mercado inmobiliario en Chile.
          Trabajo donde se cruzan el branding y el contenido, los datos y la tecnología, y el performance marketing.
        </p>
        <p>
          En LinkedIn comparto lo que aprendo con {formatNumber(LINKEDIN.followers)} profesionales. Además creé y conduzco
          <a href="https://efectopodcast.com/" target="_blank" rel="noopener">Efecto Podcast</a>, donde converso con
          líderes de marketing y negocios, y <a href="https://www.droneimagen.cl/" target="_blank" rel="noopener">DroneImagen</a>,
          un banco de fotos aéreas gratis de Chile.
        </p>
        <h2>Formación</h2>
        <ul>
          <li>Magíster en Dirección de Marketing y Gestión Comercial — Universidad Diego Portales</li>
          <li>Posgrado en Innovación y Transformación Digital — Florida International University</li>
          <li>Posgrado en Innovación y Gestión Digital — Universidad Adolfo Ibáñez</li>
          <li>Periodista — Universidad Academia de Humanismo Cristiano</li>
        </ul>
      </div>
      <a class="btn btn-primary" href={LINKEDIN_URL} target="_blank" rel="noopener">Escríbeme por LinkedIn</a>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; }
  .photo { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); position: sticky; top: 90px; }
  .photo img { display: block; width: 100%; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 10px 0 20px; }
  .btn { margin-top: 24px; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .photo { position: static; max-width: 360px; } }
</style>
