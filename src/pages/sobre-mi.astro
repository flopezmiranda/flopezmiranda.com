---
import Base from '../layouts/Base.astro';
import LinkedInButtons from '../components/LinkedInButtons.astro';
import { LINKEDIN, formatNumber, compact } from '../data/linkedin';
import { faqPage, PERSON_ID, SITE_URL } from '../seo';

// Datos clave en formato de ficha: fáciles de citar para buscadores y asistentes de IA
const facts = [
  { k: 'Cargo actual', v: 'CMO & Growth Lead en TOCTOC (tecnología para el mercado inmobiliario, Chile)' },
  { k: 'Especialidades', v: 'Branding y contenido, datos y tecnología, performance marketing' },
  { k: 'Formación', v: 'Periodista y Magíster en Dirección de Marketing y Gestión Comercial (UDP)' },
  { k: 'Proyectos', v: 'Creador y conductor de Efecto Podcast; creador de DroneImagen' },
  { k: 'Comunidad', v: `${formatNumber(LINKEDIN.followers)} seguidores y ${compact(LINKEDIN.impressions)} de impresiones al año en LinkedIn` },
  { k: 'País', v: 'Chile' },
];

const education = [
  { degree: 'Magíster en Dirección de Marketing y Gestión Comercial', school: 'Universidad Diego Portales', years: '2020 – 2022' },
  { degree: 'Posgrado en Innovación y Transformación Digital', school: 'Florida International University', years: '2022' },
  { degree: 'Posgrado en Innovación y Gestión Digital', school: 'Universidad Adolfo Ibáñez', years: '2014 – 2015' },
  { degree: 'Periodista, Licenciado en Comunicación Social', school: 'Universidad Academia de Humanismo Cristiano', years: '2006 – 2012' },
];

const faqs = [
  {
    q: '¿A qué se dedica Felipe López Miranda?',
    a: 'Es CMO & Growth Lead de TOCTOC, empresa chilena de tecnología para el mercado inmobiliario, donde lidera marketing y crecimiento. Además escribe sobre marketing, datos e IA en LinkedIn y conduce Efecto Podcast.',
  },
  {
    q: '¿Qué estudió Felipe López Miranda?',
    a: 'Es periodista (Universidad Academia de Humanismo Cristiano) y Magíster en Dirección de Marketing y Gestión Comercial (Universidad Diego Portales). Tiene posgrados en innovación y transformación digital en Florida International University y en la Universidad Adolfo Ibáñez.',
  },
  {
    q: '¿Dónde puedo seguir su contenido?',
    a: `En LinkedIn, donde publica cada semana para ${formatNumber(LINKEDIN.followers)} seguidores y tiene una newsletter. También en Efecto Podcast (efectopodcast.com y YouTube) y en Instagram (@flopezmiranda).`,
  },
  {
    q: '¿Cómo contactar a Felipe López Miranda?',
    a: 'La forma más directa es escribirle por LinkedIn.',
  },
];

const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${SITE_URL}/sobre-mi/#profile`,
  url: `${SITE_URL}/sobre-mi/`,
  name: 'Sobre Felipe López Miranda',
  inLanguage: 'es-CL',
  mainEntity: { '@id': PERSON_ID },
  dateModified: new Date(LINKEDIN.period.to).toISOString(),
};
---

<Base
  title="Sobre mí"
  fullTitle="Felipe López Miranda: CMO, periodista y creador de Efecto Podcast"
  description="Felipe López Miranda es CMO & Growth Lead en TOCTOC, periodista y Magíster en Marketing (UDP). Escribe sobre marketing, datos e IA y conduce Efecto Podcast."
  type="profile"
  schema={[profilePage, faqPage(faqs)]}
  crumbs={[{ name: 'Sobre mí', path: '/sobre-mi/' }]}
>
  <section class="section container about">
    <figure class="photo">
      <img src="/img/retrato.webp" alt="Retrato de Felipe López Miranda" width="1254" height="1254" fetchpriority="high" />
    </figure>
    <div>
      <p class="kicker">Sobre mí</p>
      <h1>Hola, soy <span class="grad">Felipe López Miranda</span></h1>
      <p class="answer">
        Soy CMO & Growth Lead en <strong>TOCTOC</strong>, periodista y Magíster en Dirección de Marketing. Escribo sobre
        marketing, datos e inteligencia artificial, y conduzco <strong>Efecto Podcast</strong>.
      </p>

      <aside class="facts card" aria-labelledby="en-breve">
        <h2 id="en-breve">En breve</h2>
        <dl>
          {
            facts.map((f) => (
              <div>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>

      <div class="prose">
        <h2>Qué hago</h2>
        <p>
          En TOCTOC lidero marketing y crecimiento. Trabajo donde se cruzan el branding y el contenido, los datos y la
          tecnología, y el performance marketing: que la marca diga algo, que los números lo prueben y que la inversión en
          medios rinda.
        </p>
        <p>
          En LinkedIn comparto lo que aprendo con {formatNumber(LINKEDIN.followers)} profesionales, sobre todo de agencias
          y equipos de marketing de Chile, Argentina, Colombia, México y España. Creé y conduzco{' '}
          <a href="https://efectopodcast.com/" target="_blank" rel="noopener">Efecto Podcast</a>, con 39 episodios de
          conversaciones con líderes de marketing y negocios, y <a href="/droneimagen/">DroneImagen</a>, un banco de más de
          1.100 fotos aéreas gratis de Chile.
        </p>

        <h2>Formación</h2>
        <ul class="edu">
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>
                  {e.school} · {e.years}
                </span>
              </li>
            ))
          }
        </ul>

        <h2>Preguntas frecuentes</h2>
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="cta"><LinkedInButtons /></div>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; }
  .photo { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); position: sticky; top: 90px; }
  .photo img { display: block; width: 100%; height: auto; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 10px 0 16px; }
  .answer { font-size: 1.15rem; color: var(--muted); margin: 0 0 24px; }
  .answer strong { color: var(--text); }
  .facts { padding: 20px 22px; margin-bottom: 8px; }
  .facts h2 { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .facts dl { margin: 0; display: grid; gap: 10px; }
  .facts dl > div { display: grid; grid-template-columns: 130px 1fr; gap: 12px; font-size: 0.9rem; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .edu { list-style: none; padding: 0; display: grid; gap: 12px; }
  .edu li { display: flex; flex-direction: column; }
  .edu span { color: var(--muted); font-size: 0.9rem; }
  .prose details { border-bottom: 1px solid var(--line); padding: 12px 0; }
  .prose summary { cursor: pointer; font-family: var(--head); font-weight: 600; font-size: 0.95rem; color: var(--text); }
  .prose details p { margin: 8px 0 0; font-size: 0.95rem; }
  .cta { margin-top: 28px; }
  @media (max-width: 820px) {
    .about { grid-template-columns: 1fr; }
    .photo { position: static; max-width: 360px; }
    .facts dl > div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
